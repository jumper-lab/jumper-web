---
import '../simple.css';
const base='/izigym-lp/assets/';
const wa='https://api.whatsapp.com/send/?phone=5511952137022&text='+encodeURIComponent('Olá! Vim pela landing da IZI Gym e quero saber sobre o primeiro mês por R$ 27.');
const arrow='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg>';
const whats=`<img src="${base}whatsapp.svg" width="24" height="24" alt=""/>`;
const experienceImageSizes='(max-width: 767px) calc(100vw - 40px), 42vw';
const pillars=[{name:'Studio',tag:'Movimento que motiva.',image:'simple/yoga-640.webp',srcset:`${base}simple/yoga-640.webp 640w, ${base}simple/yoga-1000.webp 1000w`,alt:'Aluna praticando yoga com orientação de uma professora da IZI Gym',description:'Yoga, pilates, abdominal e alongamento. Mais de 100 aulas coletivas para encontrar seu ritmo, com orientação de professores preparados.'},{name:'Cycle',tag:'Encontre outro ritmo.',image:'simple/cycle-800.webp',srcset:`${base}simple/cycle-800.webp 800w, ${base}simple/cycle-1000.webp 1000w`,alt:'Alunos durante aula de spinning na IZI Gym',description:'Música, energia e orientação em aulas de spinning que conectam condicionamento e comunidade. Izi cycle ilimitado no plano completo.'},{name:'Relax',tag:'Recuperar também é treinar.',image:'vibe-oficial.webp',alt:'Vista do ambiente interno da IZI Gym',description:'Depois do treino, desacelere. A sala relax tem cadeiras de massagem e um ambiente tranquilo para cuidar do corpo e da mente.'}];
const faqs=[['Quanto pago depois do primeiro mês?','A oferta é de R$ 27 no primeiro mês do Plano Izi Premium. As demais mensalidades são de R$ 167. Confirme com a equipe a disponibilidade e todas as condições antes da matrícula.'],['O que está incluído na experiência completa?','Izi studio, Izi cycle e Izi relax ilimitados, bioimpedância mensal e cinco convidados por mês, conforme o plano completo apresentado na campanha.'],['Estou voltando a treinar. A IZI é para mim?','Sim. A proposta da IZI é acolher diferentes ritmos, com professores preparados e uma estrutura organizada para ajudar você a criar constância.'],['A academia tem estacionamento?','Sim. Estacionamento gratuito com valet por até duas horas ao dia.'],['Onde fica e como faço a matrícula?','Estamos na Rua Cerro Corá, 2235, Vila Romana, São Paulo. Use o botão de matrícula para preencher seus dados ou converse com a equipe pelo WhatsApp.']];
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>IZI Gym Vila Romana — Primeiro mês por R$ 27</title><meta name="description" content="Seu primeiro mês por R$ 27 na IZI Gym Vila Romana. Plano completo com studio, cycle e relax ilimitados."/><meta name="robots" content="index,follow,max-image-preview:large"/><meta name="theme-color" content="#FFFFFF"/><link rel="canonical" href="https://site.jumper.dev.br/izigym-lp-vilaromana/"/>{pillars.map(p=><link rel="preload" as="image" href={base+p.image} imagesrcset={p.srcset} imagesizes={experienceImageSizes} fetchpriority="low"/>)}<link rel="preload" as="image" href={`${base}simple/cycle-800.webp`} imagesrcset={`${base}simple/cycle-640.webp 640w, ${base}simple/cycle-800.webp 800w`} imagesizes="100vw" media="(max-width:767px)" fetchpriority="high"/><link rel="preload" as="image" href={`${base}academia-960.webp`} imagesrcset={`${base}academia-960.webp 960w, ${base}academia-1440.webp 1440w`} imagesizes="100vw" media="(min-width:768px)" fetchpriority="high"/><link rel="icon" href={`${base}favicon.png`}/></head>
<body><a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header class="header"><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span>+</span></button><nav id="navigation" aria-label="Navegação principal"><a href="#academia">A academia</a><a href="#experiencias">Experiências</a><a href="#planos">Planos</a><a class="nav-mobile" href="#localizacao">Como chegar</a></nav><a class="brand" href="#inicio" aria-label="IZI Gym início"><img src={`${base}brand/izi-gym-vermelho.png`} width="1182" height="1126" alt="IZI Gym"/></a><button class="pill header-action" data-enroll="Primeiro mês">Quero fazer parte <Fragment set:html={arrow}/></button></header>
<main id="conteudo">
<section class="hero" id="inicio" aria-labelledby="headline"><picture><source media="(max-width:767px)" srcset={`${base}simple/cycle-640.webp 640w, ${base}simple/cycle-800.webp 800w`} sizes="100vw"/><img class="hero-image" src={`${base}academia-960.webp`} srcset={`${base}academia-960.webp 960w, ${base}academia-1440.webp 1440w`} sizes="100vw" width="1440" height="1080" alt="Pessoas treinando na IZI Gym" fetchpriority="high"/></picture><div class="hero-scrim"></div><div class="hero-layout"><div class="hero-story hero-offer"><p class="label">[ CONDIÇÃO DE INAUGURAÇÃO · IZI VILA ROMANA ]</p><h1 id="headline">Seu primeiro mês<br/> por <span class="hero-price">R$ 27<sup>*</sup></span></h1><p class="hero-benefit">Plano completo com <strong>studio, cycle e relax ilimitados.</strong></p><button class="pill hero-button primary-sale" data-enroll="Primeiro mês">Garantir 1º mês por R$ 27 <Fragment set:html={arrow}/></button><small class="hero-terms">Depois, R$ 167/mês. Oferta por tempo limitado.</small><div class="hero-proof" aria-label="Diferenciais da IZI Gym"><span><strong>1.600 m²</strong> de estrutura</span><span><strong>+100</strong> aulas</span><span>Aberto <strong>7 dias</strong></span></div></div><a class="scroll-cue" href="#academia" aria-label="Conheça a IZI Gym"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a></div></section>
<section class="intro section" id="academia"><div class="section-kicker"><span class="label">[ 01 / A IZI ]</span><span class="label">ESPAÇO PARA SER VOCÊ</span></div><div class="intro-grid"><h2 data-enter><span class="heading-line">Um lugar</span><span class="heading-line">para treinar.</span><span class="heading-line heading-muted">Uma vontade</span><span class="heading-line heading-muted">de voltar.</span></h2><div class="intro-copy" data-enter><p>Quando o ambiente funciona, o treino rende mais. Na IZI, espaço, equipamentos e pessoas se encontram para fazer o movimento caber na sua vida.</p><p>Estrutura organizada, professores preparados e liberdade para começar — ou recomeçar — no seu ritmo.</p><a class="text-link" href="#experiencias">Descubra sua experiência <Fragment set:html={arrow}/></a></div></div></section>
<section class="experiences section" id="experiencias"><div class="section-kicker"><span class="label">[ 02 / EXPERIÊNCIAS ]</span><span class="label">SEU CORPO. SEU RITMO.</span></div><div class="experience-layout"><div class="experience-copy"><h2 data-enter>Mais formas<br/>de ficar <em>bem.</em></h2><div class="pillar-tabs" role="tablist" aria-label="Experiências da IZI">{pillars.map((p,i)=><button role="tab" id={`tab-${i}`} aria-selected={i===0?'true':'false'} aria-controls={`pillar-${i}`} tabindex={i===0?0:-1}><span class="label">0{i+1}</span> Izi {p.name}<span class="tab-sign" aria-hidden="true">+</span></button>)}</div><p class="tabs-help">Escolha uma experiência para conhecer.</p></div><div class="pillar-panels">{pillars.map((p,i)=><article id={`pillar-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} hidden={i!==0}><div class="pillar-photo"><img src={base+p.image} srcset={p.srcset} sizes={experienceImageSizes} width="750" height="1000" alt={p.alt} loading="eager" fetchpriority="low" decoding="async"/><span class="photo-label label">[ IZI {p.name.toUpperCase()} ]</span></div><div class="pillar-caption"><h3>{p.tag}</h3><p>{p.description}</p></div></article>)}</div></div></section>
<section class="space section" id="estrutura"><div class="section-kicker"><span class="label">[ 03 / POR DENTRO ]</span><span class="label">ESTRUTURA DE CENTRO DE TREINAMENTO</span></div><div class="section-heading"><h2 data-enter>O espaço faz<br/><em>a diferença.</em></h2><p data-enter>Equipamentos de ponta, luz, organização e conforto. Cada detalhe para você focar no seu treino.</p></div><div class="video-wrap" data-enter><video controls playsinline preload="none" poster={`${base}simple/video-poster.webp`} width="1600" height="900" aria-label="Tour pela estrutura da IZI Gym"><source src={`${base}izigym.mp4`} type="video/mp4"/></video></div><div class="space-notes"><span class="label">[ UM OLHAR POR DENTRO DA IZI ]</span><p>Vestiários com secador e água quente.<br/>Equipamentos das melhores marcas.</p></div><div class="rail-heading"><h2 data-enter><span class="heading-line">Um mundo inteiro</span><span class="heading-line">de movimento.</span><em class="heading-line">A IZI mostra como.</em></h2><p>Ambientes reais, pessoas reais e diferentes maneiras de colocar o bem-estar na rotina.</p></div><div class="photo-rail" tabindex="0" aria-label="Fotos da academia, carrossel infinito; deslize para conhecer"><figure><img src={`${base}simple/space-640.webp`} width="640" height="960" alt="Detalhe de equipamento de musculação da IZI" loading="lazy"/><figcaption><span>01 /</span> Precisão em cada movimento.</figcaption></figure><figure><img src={`${base}rotina-oficial.webp`} width="700" height="600" alt="Halteres organizados na área de treino da IZI" loading="lazy"/><figcaption><span>02 /</span> Tudo no seu lugar.</figcaption></figure><figure><img src={`${base}simple/cycle-640.webp`} width="640" height="853" alt="Aula de cycle com alunos da IZI" loading="lazy"/><figcaption><span>03 /</span> Energia compartilhada.</figcaption></figure><figure><img src={`${base}simple/yoga-640.webp`} srcset={`${base}simple/yoga-640.webp 640w, ${base}simple/yoga-1000.webp 1000w`} sizes="(max-width:767px) 82vw, 440px" width="640" height="853" alt="Aluna praticando yoga com orientação de uma professora da IZI Gym" loading="lazy" decoding="async"/><figcaption><span>04 /</span> Movimento para todos os ritmos.</figcaption></figure><figure><img src={`${base}simple/hall-1000.webp`} width="1000" height="1500" alt="Equipamentos de musculação na área interna da IZI Gym" loading="lazy"/><figcaption><span>05 /</span> Estrutura para evoluir.</figcaption></figure><figure><img src={`${base}cardio.webp`} width="1800" height="1350" alt="Área de cardio com esteiras da IZI Gym" loading="lazy"/><figcaption><span>06 /</span> Cardio com espaço e conforto.</figcaption></figure><figure><img src={`${base}simple/gallery-relax.webp`} width="1200" height="1800" alt="Poltronas de massagem na área IZI Relax" loading="lazy"/><figcaption><span>07 /</span> Uma pausa para recuperar.</figcaption></figure><figure><img src={`${base}simple/gallery-pesos.webp`} width="1200" height="800" alt="Área ampla de pesos livres da IZI Gym" loading="lazy"/><figcaption><span>08 /</span> Liberdade para o seu treino.</figcaption></figure><figure><img src={`${base}simple/gallery-maquinas.webp`} width="1200" height="1800" alt="Corredor de máquinas com a marca IZI Gym" loading="lazy"/><figcaption><span>09 /</span> Tecnologia em cada escolha.</figcaption></figure></div><p class="rail-hint label">DESLIZE PARA EXPLORAR <span data-rail-status aria-live="polite">01 / 09</span></p><button class="pill primary-sale rail-cta" data-enroll="Primeiro mês">Quero viver a experiência IZI <Fragment set:html={arrow}/></button></section>
<section class="manifesto"><img src={`${base}comunidade.webp`} width="1800" height="1024" alt="Grupo diverso de pessoas sorrindo depois do treino" loading="lazy" decoding="async"/><div class="manifesto-copy"><p class="label">[ PESSOAS REAIS. MOVIMENTO REAL. ]</p><h2 data-enter><span class="heading-line">Não precisa</span><span class="heading-line">mudar quem é.</span><em class="heading-line">Só começar.</em></h2><p>Sem pressão, com orientação e uma energia que dá vontade de continuar. Aqui, o treino é seu.</p><button class="pill light primary-sale" data-enroll="Aulas coletivas">Quero fazer parte <Fragment set:html={arrow}/></button></div></section>
<section class="plans section" id="planos"><div class="section-kicker"><span class="label">[ 04 / PLANOS ]</span><span class="label">SIMPLES DE ESCOLHER</span></div><div class="section-heading"><h2 data-enter>Seu próximo<br/><em>começo.</em></h2><p>Escolha o essencial ou viva a experiência completa. A gente ajuda você a encontrar o seu plano.</p></div><div class="plans-grid"><article class="plan featured" data-enter><div class="plan-top"><span class="label">[ OFERTA ANUNCIADA ]</span><span class="tag">1º mês especial</span></div><h3>Experiência completa</h3><p class="plan-subtitle">Izi studio + cycle + relax</p><div class="plan-price"><span>R$</span><strong>27</strong><span>/ 1º mês*</span></div><p>Depois, R$ 167/mês.</p><ul><li>Izi studio, cycle e relax ilimitados</li><li>Bioimpedância mensal</li><li>5 convidados por mês</li></ul><button class="pill dark primary-sale" data-enroll="Prime">Garantir meu 1º mês <Fragment set:html={arrow}/></button></article><article class="plan" data-enter><div class="plan-top"><span class="label">[ O ESSENCIAL ]</span></div><h3>Izi One</h3><p class="plan-subtitle">Seu treino, do seu jeito.</p><div class="plan-price"><span>R$</span><strong>157</strong><span>/ mês</span></div><p>Para manter sua rotina em movimento.</p><ul><li>Izi studio ilimitado</li><li>Bioimpedância trimestral</li></ul><button class="pill" data-enroll="One">Escolher Izi One <Fragment set:html={arrow}/></button></article></div><p class="legal">*Condição de inauguração por tempo limitado no Plano Izi Premium. Demais mensalidades: R$ 167. Consulte as condições de contratação com a equipe.</p><a class="pill whatsapp" href={wa} target="_blank" rel="noopener noreferrer" data-cta="planos">Tirar dúvidas no WhatsApp <Fragment set:html={whats}/></a></section>
<section class="faq section"><div><p class="label">[ 05 / SEM DÚVIDAS ]</p><h2 data-enter>Antes de<br/><em>começar.</em></h2></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
<section class="location section" id="localizacao"><div class="location-photo"><img src={`${base}simple/hall-1000.webp`} width="667" height="1000" alt="Espaço de musculação da unidade IZI Gym Vila Romana" loading="lazy"/></div><div class="location-copy"><p class="label">[ IZI GYM / SÃO PAULO ]</p><h2 data-enter>Bem perto.<br/>Bem <em>você.</em></h2><address>Rua Cerro Corá, 2235<br/>Vila Romana · São Paulo</address><p>Todos os dias da semana.<br/>Estacionamento com valet gratuito por 2h/dia.</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=IZI+Gym+Rua+Cerro+Cor%C3%A1+2235+S%C3%A3o+Paulo" target="_blank" rel="noopener noreferrer">Como chegar <Fragment set:html={arrow}/></a><a class="pill whatsapp" href={wa} target="_blank" rel="noopener noreferrer" data-cta="localizacao">Conversar com a IZI <Fragment set:html={whats}/></a></div></section>
</main><section class="footer-conversion"><div><p class="label">[ SEU PRÓXIMO PASSO ]</p><h2><span class="heading-line">Comece agora.</span><em class="heading-line">Continue por você.</em></h2></div><div class="footer-offer"><p>Seu primeiro mês por R$ 27 no plano completo.</p><button class="pill primary-sale" data-enroll="Primeiro mês">Garantir 1º mês por R$ 27 <Fragment set:html={arrow}/></button></div></section><footer class="site-footer"><p class="footer-follow">SIGA A IZI GYM <a href="https://www.instagram.com/izigym.brasil/" target="_blank" rel="noopener noreferrer">@IZIGYM.BRASIL</a></p><div class="footer-links"><div><p class="label">[ NOSSOS CONTATOS ]</p><a href="tel:+5511952137022">11 95213-7022</a><a href="https://www.instagram.com/izigym.brasil/" target="_blank" rel="noopener noreferrer">@izigym.brasil <Fragment set:html={arrow}/></a></div><div><p class="label">[ ENDEREÇO ]</p><address>R. Cerro Corá, 2235<br/>Alto de Pinheiros - São Paulo - SP<br/>02675-031</address><p class="label footer-hours-title">[ FUNCIONAMENTO ]</p><p>Segunda a Sexta<br/><strong>05:00 - 23:00</strong></p><p>Sábado e Domingo<br/><strong>08:00 - 20:00</strong></p></div><nav aria-label="Navegação do rodapé"><a href="#academia">A academia</a><a href="#experiencias">Experiências</a><a href="#planos">Planos</a><a href="#localizacao">Como chegar</a></nav><div class="footer-return"><a href="#inicio" class="back-top">Voltar ao topo <Fragment set:html={arrow}/></a></div></div><div class="footer-brand"><img src={`${base}brand/izi-gym-vermelho.png`} width="1182" height="1126" alt="IZI Gym" loading="lazy"/><p>Treinem Alto de<br/>Pinheiros.</p></div><div class="footer-legal"><span>IZI GYM · ALTO DE PINHEIROS</span><span>2026 © IZI GYM</span></div></footer>
<div class="mobile-cta" inert><div><small>1º mês</small><span>R$ 27<sup>*</sup></span></div><button class="pill dark primary-sale" data-enroll="Primeiro mês">Garantir R$ 27 <Fragment set:html={arrow}/></button></div>
<dialog id="enrollment" aria-labelledby="enrollment-title"><div class="dialog-header"><h2 id="enrollment-title">Sua matrícula na IZI</h2><button class="close" aria-label="Fechar matrícula">×</button></div><div id="form-host"></div><p class="form-fallback">Prefere falar com a equipe?</p><a class="pill whatsapp" href={wa} target="_blank" rel="noopener noreferrer" data-cta="formulario">Continue pelo WhatsApp <Fragment set:html={whats}/></a></dialog>
<script src="../simple.ts"></script>
</body></html>
