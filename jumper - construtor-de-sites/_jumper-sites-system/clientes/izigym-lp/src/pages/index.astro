<img src={`${base}assets/equipamentos-360.webp`} srcset={`${base}assets/equipamentos-360.webp 360w, ${base}assets/equipamentos-640.webp 640w`} sizes="(max-width: 767px) calc(50vw - 28px), 30vw" width="640" height="480" alt="Equipamentos de musculação IZI Gym" loading="lazy" decoding="async"/><figcaption>03 / Equipamentos de ponta</figcaption></figure></div></section>
