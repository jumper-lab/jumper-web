{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rodeio-site-preview",
  "main": "cloudflare/worker.mjs",
  "account_id": "e23efa36a1e09015eebb2b36bdfcf201",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "rodeio.jumper.dev.br",
      "custom_domain": true
    }
  ]
}
