{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jumper-hoster",
  "main": "cloudflare/worker.mjs",
  "account_id": "e23efa36a1e09015eebb2b36bdfcf201",
  "compatibility_date": "2026-09-09",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./hoster-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "JUMPER_BRIEFING_DRAFTS",
      "id": "47cdb91716ab4cd99d66807fae60b655"
    },
    {
      "binding": "JUMPER_HUB_OPERATIONS",
      "id": "c561dc1cddb04f889a297343d50bc20d"
    }
  ],
  "d1_databases": [
    {
      "binding": "IZI_LEADS_DB",
      "database_name": "izi-lp-CerroCora-leads",
      "database_id": "e06d432d-eaf4-47cb-90a2-fd7b6cc54ebc",
      "migrations_dir": "cloudflare/migrations/izi-lp-CerroCora-leads"
    },
    {
      "binding": "IZI_LEADS_TEST_DB",
      "database_name": "izi-lp-CerroCora-leads-dev",
      "database_id": "af52ce85-b519-473c-ad3c-66654cf3aabd",
      "migrations_dir": "cloudflare/migrations/izi-lp-CerroCora-leads-dev"
    },
    {
      "binding": "IZI_FRANCHISE_DB",
      "database_name": "izi-lp-franquias-leads",
      "database_id": "4553bc65-eeb8-4404-aa57-e44692bcc9a3"
    }
  ],
  "ratelimits": [
    {
      "name": "IZI_LEAD_LIMITER",
      "namespace_id": "348672410",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "site.jumper.dev.br",
      "custom_domain": true
    },
    {
      "pattern": "izigym.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.izigym.com.br",
      "custom_domain": true
    },
    {
      "pattern": "cerrocora.izigym.com.br",
      "custom_domain": true
    }
  ]
}
