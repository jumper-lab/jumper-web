{
  "name": "rodeio-restaurante",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "build:cloudflare": "SITE_URL=https://site.jumper.dev.br BASE_PATH=/rodeio astro build && npm ci --prefix ../izigym-lp && npm run build --prefix ../izigym-lp && node scripts/stage-hoster.mjs",
    "capture:vercel-sites": "node scripts/capture-vercel-sites.mjs",
    "stage:hoster": "node scripts/stage-hoster.mjs",
    "preflight:cloudflare": "node scripts/preflight-hoster.mjs",
    "preflight:dev": "node scripts/preflight-hoster-dev.mjs",
    "inventory:dev": "node scripts/update-dev-inventory.mjs",
    "verify:dev-config": "node scripts/verify-hoster-dev-config.mjs",
    "test:dev-worker": "node --test scripts/tests/dev-worker.test.mjs scripts/tests/dev-access.test.mjs",
    "test:dev-preflight": "node --test scripts/tests/dev-preflight.test.mjs",
    "deploy:dev": "npm run build:cloudflare && node scripts/deploy-hoster-dev.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && npm run preflight:cloudflare && node scripts/deploy-hoster.mjs",
    "postbuild": "node scripts/prune-unused-photo-masters.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bodoni-moda": "^5.2.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "wrangler": "4.144.0"
  }
}
