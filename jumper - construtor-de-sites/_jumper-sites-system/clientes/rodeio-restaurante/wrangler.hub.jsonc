{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jumper-hub",
  "main": "cloudflare/hub-worker.mjs",
  "account_id": "e23efa36a1e09015eebb2b36bdfcf201",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "assets": {
    "directory": "./hub-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "services": [
    { "binding": "HOSTER", "service": "jumper-hoster" }
  ],
  "routes": [
    { "pattern": "site.jumper.dev.br/", "zone_name": "jumper.dev.br" },
    { "pattern": "site.jumper.dev.br/hub-assets/*", "zone_name": "jumper.dev.br" }
  ]
}
