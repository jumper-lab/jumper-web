{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jumper-hoster-dev",
  "main": "cloudflare/dev-worker.mjs",
  "account_id": "e23efa36a1e09015eebb2b36bdfcf201",
  "compatibility_date": "2026-09-09",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./hoster-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "site.jumper.dev.br/rodeio/*", "zone_name": "jumper.dev.br" },
    { "pattern": "site.jumper.dev.br/izigym/*", "zone_name": "jumper.dev.br" },
    { "pattern": "site.jumper.dev.br/izigym-lp/*", "zone_name": "jumper.dev.br" },
    { "pattern": "site.jumper.dev.br/izigym-lp-vilaromana/*", "zone_name": "jumper.dev.br" },
    { "pattern": "site.jumper.dev.br/casabelie/*", "zone_name": "jumper.dev.br" },
    { "pattern": "site.jumper.dev.br/casabelie-2/*", "zone_name": "jumper.dev.br" },
    { "pattern": "site.jumper.dev.br/casabelie-3/*", "zone_name": "jumper.dev.br" }
  ]
}
