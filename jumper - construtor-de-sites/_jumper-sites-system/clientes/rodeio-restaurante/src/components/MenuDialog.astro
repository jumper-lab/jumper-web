---
import content from '../../data/content.json';
import '../styles/menu-dialog.css';
import '../styles/pdf-page-zoom.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const pdfUrl=`${base}${content.menu_url}`;
const pages=[1,2,3,4];
---
<dialog id="digital-menu-dialog" class="digital-menu-dialog" aria-labelledby="digital-menu-title" data-menu-url={pdfUrl} data-local-content>
  <div class="digital-menu-header">
    <h2 id="digital-menu-title">Cardápio Rodeio</h2>
    <button type="button" class="digital-menu-close" data-close-digital-menu autofocus>Fechar <span aria-hidden="true">×</span></button>
  </div>
  <div class="digital-menu-content" data-menu-frame-slot>
    <p class="digital-menu-status" data-menu-status role="status" hidden>Carregando o cardápio…</p>
    <div class="digital-menu-pdf-pages" aria-label="Páginas do cardápio Rodeio">
      {pages.map(page=><div class="pdf-page-zoom" data-pdf-page><img src={`${base}/cardapio-paginas/pagina-${page}.webp`} alt={`Página ${page} de ${pages.length} do cardápio Rodeio`} width="1555" height="2200" loading={page===1?'eager':'lazy'} decoding="async" draggable="false"/></div>)}
    </div>
  </div>
  <div class="digital-menu-footer"><a href={pdfUrl} download="cardapio-rodeio.pdf">Baixar cardápio <span aria-hidden="true">↓</span></a><a href={`${base}/cardapio/completo/`}>Abrir em tela cheia <span aria-hidden="true">↗</span></a></div>
</dialog>
<script src="../scripts/menu-dialog.ts"></script>
<script src="../scripts/pdf-page-zoom.ts"></script>
