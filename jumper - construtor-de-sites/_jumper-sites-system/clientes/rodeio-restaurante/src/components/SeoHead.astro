---
/** Metadata and stable identities for the brand and the restaurant on this page. */
export interface Organization {
  id: string;
  name: string;
  url: string;
  logo: string;
  telephone?: string;
  sameAs?: string[];
  foundingDate?: string;
}

export interface Restaurant {
  id: string;
  name: string;
  url: string;
  street: string;
  city: string;
  region: string;
  postalCode: string;
  country: string;
  reservationUrl: string;
  image: string;
  menu: string;
  map: string;
  description: string;
  hours: Record<string,unknown>[];
}

export interface Props {
  title: string;
  description: string; // >= 20 chars, unica por pagina (o gate reprova duplicada/curta)
  canonical: string | URL;
  ogImage: string | URL; // absoluta de preferencia
  locale?: string;
  siteName?: string;
  ogType?: "website" | "article";
  favicon?: string;
  organization: Organization;
  restaurant?: Restaurant;
  noindex?: boolean;
  nofollow?: boolean;
  breadcrumbs?: {name:string;url:string}[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  locale = "pt_BR",
  siteName,
  ogType = "website",
  favicon = "/favicon.svg",
  organization,
  restaurant,
  noindex = false,
  nofollow = false,
  breadcrumbs = [],
} = Astro.props;

const canonicalStr = canonical.toString();
const ogImageStr = ogImage.toString();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedFavicon = favicon.startsWith('/') ? `${base}${favicon}` : favicon;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organization.id,
      name: organization.name,
      url: organization.url,
      logo: organization.logo,
      ...(organization.telephone && { telephone: organization.telephone }),
      ...(organization.sameAs && { sameAs: organization.sameAs }),
      ...(organization.foundingDate && { foundingDate: organization.foundingDate }),
      ...(organization.telephone && { contactPoint: { '@type':'ContactPoint', telephone:organization.telephone, contactType:'reservas e atendimento', availableLanguage:'pt-BR' } }),
    },
    { '@type':'WebSite','@id':new URL('#website',organization.url).href,name:siteName||organization.name,url:organization.url,publisher:{'@id':organization.id},inLanguage:'pt-BR' },
    { '@type':'WebPage','@id':canonicalStr,url:canonicalStr,name:title,description,inLanguage:'pt-BR',isPartOf:{'@id':new URL('#website',organization.url).href},breadcrumb:{'@id':canonicalStr+'#breadcrumb'},...(restaurant ? {mainEntity:{'@id':restaurant.id}} : {}) },
    { '@type':'BreadcrumbList','@id':canonicalStr+'#breadcrumb',itemListElement:breadcrumbs.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.name,item:item.url})) },
    ...(restaurant ? [{
      "@type": "Restaurant",
      "@id": restaurant.id,
      name: restaurant.name,
      url: restaurant.url,
      parentOrganization: { "@id": organization.id },
      address: {
        "@type": "PostalAddress",
        streetAddress: restaurant.street,
        addressLocality: restaurant.city,
        addressRegion: restaurant.region,
        postalCode: restaurant.postalCode,
        addressCountry: restaurant.country,
      },
      acceptsReservations: restaurant.reservationUrl,
      image: restaurant.image,
      hasMenu: restaurant.menu,
      hasMap: restaurant.map,
      description: restaurant.description,
      servesCuisine: 'Carnes',
      openingHoursSpecification: restaurant.hours,
      mainEntityOfPage: { '@id':canonicalStr },
    }] : []),
  ],
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalStr} />
<meta name="robots" content={`${noindex ? 'noindex' : 'index'}, ${nofollow ? 'nofollow' : 'follow'}, max-image-preview:large`}/>

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalStr} />
<meta property="og:image" content={ogImageStr} />
<meta property="og:locale" content={locale} />
{siteName && <meta property="og:site_name" content={siteName} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageStr} />

<link rel="icon" href={resolvedFavicon} />
<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

<script is:inline data-rodeio-schema type="application/ld+json" set:html={jsonLdText} />
