---
import '../styles/menu-dialog.css';
import EventsForm from './EventsForm.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<dialog id="events-page-dialog" class="digital-menu-dialog" aria-labelledby="events-page-title" data-menu-url={`${base}/eventos/orcamento/`} data-local-content data-page-label="o formulário de eventos">
  <div class="digital-menu-header">
    <h2 id="events-page-title">Eventos Rodeio</h2>
    <button type="button" class="digital-menu-close" data-close-digital-menu autofocus>Fechar <span aria-hidden="true">×</span></button>
  </div>
  <div class="digital-menu-content events-local-content" data-menu-frame-slot>
    <p class="digital-menu-status" data-menu-status role="status" hidden>Carregando a página de eventos…</p>
    <EventsForm/>
  </div>
  <div class="digital-menu-footer"><a href={`${base}/eventos/orcamento/`}>Abrir em tela cheia <span aria-hidden="true">↗</span></a></div>
</dialog>
