---
import Arrow from './Arrow.astro';
import content from '../../data/content.json';
interface Props {href:string; menuLabel?:string; primary?:boolean; light?:boolean; class?:string;}
const {href,menuLabel,primary=false,light=false,class:className=''}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const isMenuLink=href===content.menu_url || href.replace(/\/$/,'')==='/cardapio';
const resolvedHref=isMenuLink?content.menu_url:href.startsWith('/')?`${base}${href}`:href;
---
<a href={resolvedHref} class:list={['action',primary?'button':'text-link',{'light':light},className]}>{isMenuLink?(menuLabel??content.pages.menu.cta):<slot/>}<Arrow/></a>
