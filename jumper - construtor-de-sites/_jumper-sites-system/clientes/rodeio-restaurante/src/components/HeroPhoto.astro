---
import {getImage} from 'astro:assets';
import {photos, type PhotoName} from '../lib/photos';
import {responsivePhoto,photoVariant} from '../lib/responsive-photos';
interface Props {name:PhotoName;alt:string;quality?:number;phoneQuality?:number;}
const {name,alt,quality=60,phoneQuality=quality}=Astro.props;
const source=photos[name];
const crop=async(widths:number[],ratio:number,cropQuality=quality,position="centre")=>{
 const images=await Promise.all(widths.map(width=>getImage({src:source,width,height:Math.round(width/ratio),fit:'cover',position,format:'webp',quality:cropQuality})));
 return {src:images[0].src,srcset:images.map((image,i)=>`${image.src} ${widths[i]}w`).join(', ')};
};
const prepared=responsivePhoto(name)?.hero;
const [phone,tablet,desktop]=prepared?[photoVariant(prepared.phone,import.meta.env.BASE_URL),photoVariant(prepared.tablet,import.meta.env.BASE_URL),photoVariant(prepared.desktop,import.meta.env.BASE_URL)]:await Promise.all([
 crop([360,540,720,900],9/16,phoneQuality),crop([640,840,1080],4/5),crop([960,1440,1920,2560],16/9,quality,name==='cardapioHero'?'entropy':'centre')
]);
---
<picture>
 <source media="(max-width:599px) and (orientation:portrait)" srcset={phone.srcset} sizes="max(100vw, 56.25vh)" width="900" height="1600" type="image/webp"/>
 <source media="(min-width:600px) and (max-width:1199px) and (orientation:portrait)" srcset={tablet.srcset} sizes="max(100vw, 80vh)" width="1080" height="1350" type="image/webp"/>
 <img data-menu-hero={name==='cardapioHero'?true:undefined} src={desktop.src} srcset={desktop.srcset} sizes="max(100vw, 177.78vh)" width="2560" height="1440" alt={alt} loading="eager" fetchpriority="high" decoding="async"/>
</picture>
