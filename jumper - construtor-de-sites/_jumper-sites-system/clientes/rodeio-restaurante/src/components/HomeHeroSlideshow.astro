---
import { getImage } from 'astro:assets';
import { photos, type PhotoName } from '../lib/photos';

interface Slide {
  name: PhotoName;
  caption: string;
  alt: string;
}

const slides: Slide[] = [
  {
    name: 'homeBifeAcervo2024',
    caption: 'O corte, no centro da experiência',
    alt: 'Corte de carne grelhada servido com arroz no Rodeio',
  },
  {
    name: 'homeMarcaAcervo2024',
    caption: 'Rodeio · São Paulo desde 1958',
    alt: 'Letreiro Rodeio em parede de madeira iluminada',
  },
  {
    name: 'homeSalaAcervo2024',
    caption: 'A casa, pronta para receber',
    alt: 'Salão do Rodeio com mesas postas, madeira e luz natural',
  },
  {
    name: 'homeAperitivosAcervo2024',
    caption: 'Para começar, sabores da casa',
    alt: 'Seleção de aperitivos do Rodeio acompanhada de cerveja',
  },
  {
    name: 'homeCosteletasAcervo2024',
    caption: 'Clássicos servidos à mesa',
    alt: 'Costeletas grelhadas servidas com vinho no Rodeio',
  },
  {
    name: 'homeSobremesaAcervo2023',
    caption: 'Para terminar, um último sabor',
    alt: 'Sobremesa de chocolate com sorvete servida no Rodeio',
  },
];

const crop = async (name: PhotoName, widths: number[], ratio: number) => {
  const source = photos[name];
  const images = await Promise.all(widths.map((width) => getImage({
    src: source,
    width,
    height: Math.round(width / ratio),
    fit: 'cover',
    position: 'centre',
    format: 'avif',
    quality: 60,
  })));
  return {
    src: images[0].src,
    srcset: images.map((image, index) => `${image.src} ${widths[index]}w`).join(', '),
  };
};

const preparedSlides = await Promise.all(slides.map(async (slide) => {
  const [phone, tablet, desktop] = await Promise.all([
    crop(slide.name, [360, 540, 720, 900], 9 / 16),
    crop(slide.name, [640, 840, 1080], 4 / 5),
    crop(slide.name, slide.name === 'homeMarcaAcervo2024' ? [960, 1440, 1920] : [960, 1440, 1920, 2560], 16 / 9),
  ]);
  return { ...slide, phone, tablet, desktop };
}));
---

<div class="home-slideshow" data-home-slideshow data-slide-count={preparedSlides.length}>
  <div class="home-slideshow-frames" aria-hidden="true">
    {preparedSlides.map((slide, index) => (
      <div class:list={['hero-slide', { 'is-active': index === 0 }]} data-hero-slide data-caption={slide.caption}>
        <picture>
          <source
            media="(max-width:599px) and (orientation:portrait)"
            srcset={index === 0 ? slide.phone.srcset : undefined}
            data-srcset={index > 0 ? slide.phone.srcset : undefined}
            sizes="max(100vw, 56.25vh)"
            width="900"
            height="1600"
            type="image/avif"
          />
          <source
            media="(min-width:600px) and (max-width:1199px) and (orientation:portrait)"
            srcset={index === 0 ? slide.tablet.srcset : undefined}
            data-srcset={index > 0 ? slide.tablet.srcset : undefined}
            sizes="max(100vw, 80vh)"
            width="1080"
            height="1350"
            type="image/avif"
          />
          <img
            src={index === 0 ? slide.desktop.src : undefined}
            srcset={index === 0 ? slide.desktop.srcset : undefined}
            data-src={index > 0 ? slide.desktop.src : undefined}
            data-srcset={index > 0 ? slide.desktop.srcset : undefined}
            sizes="max(100vw, 177.78vh)"
            width="2560"
            height="1440"
            alt=""
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'low'}
            decoding="async"
          />
        </picture>
      </div>
    ))}
  </div>

  <div class="home-slideshow-controls" aria-label="Fotografias em destaque">
    <span class="home-slideshow-count" aria-hidden="true"><span data-slide-current>01</span> / {String(preparedSlides.length).padStart(2, '0')}</span>
    <div class="home-slideshow-dots">
      {preparedSlides.map((slide, index) => (
        <button
          type="button"
          class:list={['home-slideshow-dot', { 'is-active': index === 0 }]}
          data-slide-control={index}
          aria-label={`Exibir fotografia ${index + 1}: ${slide.caption}`}
          aria-current={index === 0 ? 'true' : undefined}
        ><span></span></button>
      ))}
    </div>
  </div>
</div>

<script>
  const slideshow = document.querySelector<HTMLElement>('[data-home-slideshow]');

  if (slideshow && slideshow.dataset.ready !== 'true') {
    slideshow.dataset.ready = 'true';
    const hero = slideshow.closest<HTMLElement>('.hero-home');
    const frames = [...slideshow.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const controls = [...slideshow.querySelectorAll<HTMLButtonElement>('[data-slide-control]')];
    const currentLabel = slideshow.querySelector<HTMLElement>('[data-slide-current]');
    const caption = slideshow.closest('figure')?.querySelector<HTMLElement>('[data-home-slide-caption]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const limitedConnection = Boolean(connection?.saveData || connection?.effectiveType === 'slow-2g' || connection?.effectiveType === '2g');
    let activeIndex = 0;
    let requestedIndex = 0;
    let gesture: { pointerId: number; startX: number; startY: number; intent: 'undecided' | 'horizontal' | 'vertical' } | null = null;
    let timer = 0;
    let transitionToken = 0;

    const loadFrame = (index: number) => {
      const frame = frames[index];
      if (!frame || frame.dataset.loaded === 'true') return;
      frame.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((source) => {
        source.srcset = source.dataset.srcset || '';
        source.removeAttribute('data-srcset');
      });
      const image = frame.querySelector<HTMLImageElement>('img[data-src]');
      if (image) {
        // Only the requested/preloaded frame becomes eager, never all six photos.
        image.loading = 'eager';
        image.srcset = image.dataset.srcset || '';
        image.src = image.dataset.src || '';
        image.removeAttribute('data-srcset');
        image.removeAttribute('data-src');
      }
      frame.dataset.loaded = 'true';
    };

    const preloadFollowingFrame = () => {
      if (limitedConnection || reducedMotion) return;
      const nextIndex = (activeIndex + 1) % frames.length;
      const preload = () => loadFrame(nextIndex);
      const idleWindow = window as Window & { requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number };
      if (typeof idleWindow.requestIdleCallback === 'function') {
        idleWindow.requestIdleCallback(preload, { timeout: 1800 });
      } else {
        globalThis.setTimeout(preload, 700);
      }
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion || limitedConnection || document.hidden || gesture) return;
      timer = window.setTimeout(() => showFrame((activeIndex + 1) % frames.length), 6500);
    };

    const commitFrame = (index: number) => {
      frames.forEach((frame, frameIndex) => frame.classList.toggle('is-active', frameIndex === index));
      controls.forEach((control, controlIndex) => {
        const isActive = controlIndex === index;
        control.classList.toggle('is-active', isActive);
        if (isActive) control.setAttribute('aria-current', 'true');
        else control.removeAttribute('aria-current');
      });
      activeIndex = requestedIndex = index;
      if (currentLabel) currentLabel.textContent = String(index + 1).padStart(2, '0');
      if (caption) caption.textContent = frames[index]?.dataset.caption || '';
      preloadFollowingFrame();
      schedule();
    };

    const showFrame = async (index: number) => {
      const normalizedIndex = (index + frames.length) % frames.length;
      requestedIndex = normalizedIndex;
      const token = ++transitionToken;
      window.clearTimeout(timer);
      if (normalizedIndex === activeIndex) {
        schedule();
        return;
      }
      loadFrame(normalizedIndex);
      const image = frames[normalizedIndex]?.querySelector('img');
      try {
        // Retain the current photograph until the requested one can be painted.
        // Slow or failed downloads must never expose an empty slide.
        if (image) await image.decode();
      } catch {
        if (token === transitionToken) {
          requestedIndex = activeIndex;
          schedule();
        }
        return;
      }
      if (token === transitionToken && !gesture) commitFrame(normalizedIndex);
    };

    const resume = () => {
      if (requestedIndex !== activeIndex) void showFrame(requestedIndex);
      else schedule();
    };

    // Touch/pens retain their native vertical scroll and pinch zoom. Tracking
    // on window also receives the end of a gesture that leaves the hero.
    hero?.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch' && event.pointerType !== 'pen') return;
      if (!event.isPrimary) {
        gesture = null;
        resume();
        return;
      }
      if (event.target instanceof Element && event.target.closest('a, button, input, select, textarea, [contenteditable="true"]')) return;
      gesture = { pointerId: event.pointerId, startX: event.clientX, startY: event.clientY, intent: 'undecided' };
      window.clearTimeout(timer);
    }, { passive: true });

    window.addEventListener('pointermove', (event) => {
      if (!gesture || event.pointerId !== gesture.pointerId || gesture.intent !== 'undecided') return;
      const dx = Math.abs(event.clientX - gesture.startX);
      const dy = Math.abs(event.clientY - gesture.startY);
      if (Math.max(dx, dy) < 10) return;
      gesture.intent = dx > dy * 1.2 ? 'horizontal' : 'vertical';
    }, { passive: true });

    window.addEventListener('pointerup', (event) => {
      if (!gesture || event.pointerId !== gesture.pointerId) return;
      const { startX, startY, intent } = gesture;
      gesture = null;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      const threshold = Math.min(90, Math.max(40, (hero?.clientWidth || innerWidth) * 0.1));
      if (intent !== 'vertical' && Math.abs(dx) >= threshold && Math.abs(dx) > Math.abs(dy) * 1.2) {
        void showFrame(requestedIndex + (dx < 0 ? 1 : -1));
      } else resume();
    }, { passive: true });

    window.addEventListener('pointercancel', (event) => {
      if (!gesture || event.pointerId !== gesture.pointerId) return;
      gesture = null;
      resume();
    }, { passive: true });

    window.addEventListener('blur', () => {
      if (!gesture) return;
      gesture = null;
      resume();
    });

    const queueInitialPreload = () => globalThis.setTimeout(preloadFollowingFrame, 3200);

    controls.forEach((control, index) => control.addEventListener('click', () => showFrame(index)));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { gesture = null; window.clearTimeout(timer); }
      else resume();
    });
    if (document.readyState === 'complete') queueInitialPreload();
    else window.addEventListener('load', queueInitialPreload, { once: true });
    schedule();
  }
</script>
