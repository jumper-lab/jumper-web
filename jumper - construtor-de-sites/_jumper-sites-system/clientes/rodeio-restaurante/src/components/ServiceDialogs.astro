---
import ServiceFormDialog from './ServiceFormDialog.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const complianceUrl = import.meta.env.PUBLIC_COMPLIANCE_FORM_URL || 'https://rodeiosp.com.br/compliance/';
---
<ServiceFormDialog kind="sac" title="Fale com o Rodeio" originalUrl="https://rodeiosp.com.br/sac/" triggerUrl={`${base}/sac/`}/>
<ServiceFormDialog kind="sac-jardins" title="SAC · Rodeio Jardins" originalUrl="https://rodeiosp.com.br/sac/jardins/"/>
<ServiceFormDialog kind="sac-iguatemi" title="SAC · Rodeio Iguatemi" originalUrl="https://rodeiosp.com.br/sac/iguatemi/"/>
<ServiceFormDialog kind="compliance" title="Compliance Rodeio" originalUrl={complianceUrl} triggerUrl={`${base}/compliance/`}/>
<dialog id="rodeio-em-casa-dialog" class="digital-menu-dialog service-form-dialog service-form-dialog-compliance" aria-labelledby="rodeio-em-casa-dialog-title" data-menu-url={`${base}/rodeio-em-casa/`} data-local-content data-page-label="Rodeio em casa">
  <div class="digital-menu-header">
    <div><p class="eyebrow">O Rodeio até você</p><h2 id="rodeio-em-casa-dialog-title">Rodeio em casa</h2></div>
    <button type="button" class="digital-menu-close" data-close-digital-menu autofocus>Fechar <span aria-hidden="true">×</span></button>
  </div>
  <div class="digital-menu-content service-form-content" data-menu-frame-slot>
    <p class="digital-menu-status" data-menu-status role="status" hidden></p>
    <h3 class="service-delivery-copy">O sabor da casa,<br/><em>onde você estiver.</em></h3>
    <p class="service-delivery-description">Peça os clássicos do Rodeio pelo WhatsApp. Consulte o atendimento sobre disponibilidade, itens e condições de entrega.</p>
  </div>
  <div class="digital-menu-footer"><a class="service-primary-action" href="https://wa.me/5511975924615" target="_blank" rel="noopener noreferrer">Pedir pelo WhatsApp <span aria-hidden="true">↗</span></a></div>
</dialog>
