---
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const icons:Record<string,string>={
 reserve:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18m-13 5 3 3 5-5"/>',
 events:'<path d="M5 3v5m-2-3h4m12 11v5m-2-3h4M13 2l1 4 4 1-4 1-1 4-1-4-4-1 4-1 1-4ZM6 12l6 6-9 3 3-9Z"/>',
 phone:'<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.69A2 2 0 0 1 22 16.92Z"/>',
 instagram:'<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/>',
 sac:'<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
 compliance:'<path d="m12 3 8 3v5c0 5-5 9-8 10-3-1-8-5-8-10V6l8-3Z"/><path d="m8 12 3 3 5-6"/>'
};
const cards=[
 {icon:'reserve',label:'Reservas',description:'Escolha a unidade e reserve sua mesa.',href:`${base}/reservas/`},
 {icon:'events',label:'Eventos',description:'Planeje seu encontro no Rodeio.',href:`${base}/eventos/`},
 {icon:'phone',label:'Telefone',description:'(11) 3474-1333',href:'tel:+551134741333'},
 {icon:'instagram',label:'Instagram',description:'@rodeiorestaurante',href:'https://www.instagram.com/rodeiorestaurante/',external:true},
 {icon:'sac',label:'Atendimento ao Cliente · SAC',description:'Dúvidas, sugestões e experiências com o Rodeio.',href:`${base}/sac/`},
 {icon:'compliance',label:'Compliance',description:'Assuntos relacionados a compliance.',href:`${base}/compliance/`}
];
---
<dialog id="contact-dialog" class="digital-menu-dialog service-form-dialog" aria-labelledby="contact-dialog-title">
 <div class="digital-menu-header"><div><p class="eyebrow">Atendimento Rodeio</p><h2 id="contact-dialog-title">Fale com a gente</h2></div><button type="button" class="digital-menu-close" data-close-contact>Fechar <span aria-hidden="true">×</span></button></div>
 <div class="digital-menu-content service-form-content"><p class="service-form-intro">Como podemos ajudar? Escolha o canal para falar com a nossa equipe.</p><div class="service-contact-list">
 {cards.map(card=><a class="service-contact-card" href={card.href} target={card.external?'_blank':undefined} rel={card.external?'noopener noreferrer':undefined}><span class="service-contact-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[card.icon]}/></span><span class="service-contact-copy"><strong>{card.label}</strong><small>{card.description}</small></span><span class="service-contact-arrow" aria-hidden="true">{card.external?'↗':'→'}</span></a>)}
 </div></div>
</dialog>
<script>import '../../wordpress/contact-dialog.js';</script>
