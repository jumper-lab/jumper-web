---
import content from '../../data/content.json';
import Photo from './Photo.astro';
import ReservationDialog from './ReservationDialog.astro';
interface Props {directory?:boolean;showNewAddress?:boolean;}
const {directory=false,showNewAddress=false}=Astro.props;
import Link from './Link.astro';
import '../styles/houses.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const internal=(href:string)=>`${base}${href}`;
const Heading=directory?'h2':'h3';
---
<div class="houses-list">
{content.units.map(unit=><article class="house-row"><a class="house-photo" href={internal(`/restaurantes/${unit.slug}/`)}><Photo name={directory ? (unit.slug==='jardins'?'jardinsDirectory':'iguatemiDirectory') : (unit.image as 'jardins'|'iguatemi')} alt={`Salão do Rodeio ${unit.name}, com mesas postas e acabamento em madeira`} sizes="(max-width:759px) calc(100vw - 48px), 53vw"/></a><div class="house-info"><Heading>{unit.display_name}</Heading><p class="house-address">{showNewAddress&&unit.slug==='jardins'&&<span class="house-new-address">Novo endereço</span>}{unit.address}<br/>{unit.district}</p><div class="house-actions"><Link href={`/restaurantes/${unit.slug}/`}>Conhecer a casa</Link><Link href={unit.widget}>Reservar no {unit.name}</Link></div></div></article>)}
</div>

{content.units.map(unit=><ReservationDialog unit={unit}/>)}
