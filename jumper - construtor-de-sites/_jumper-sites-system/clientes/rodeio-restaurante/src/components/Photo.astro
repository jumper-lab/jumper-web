---
import {type PhotoName} from '../lib/photos';
import {responsivePhoto,photoVariant} from '../lib/responsive-photos';
interface Props {name:PhotoName; alt:string; class?:string; eager?:boolean;sizes?:string; quality?:number; maxWidth?:number;entrance?:boolean;}
const {name,alt,class:className='',eager=false,sizes='(max-width: 759px) 100vw, 55vw',maxWidth=1600,entrance=true}=Astro.props;
const photo=responsivePhoto(name);
if(!photo)throw new Error(`Run prepare-responsive-photos.mjs: missing ${name}`);
const variants=photo.variants.filter(image=>image.width<=maxWidth);
const image=photoVariant(variants.length?variants:[photo.variants[0]],import.meta.env.BASE_URL);
const width=Math.min(photo.width,maxWidth);
---
<div class="photo-viewport" style={`background-image:url("${photo.preview}");background-size:cover;background-position:center`}><img data-responsive-photo data-photo-entrance={entrance ? true : undefined} src={image.src} srcset={image.srcset} sizes={sizes} width={width} height={Math.round(width*photo.height/photo.width)} class={className} alt={alt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':'low'} decoding="async" /></div>
<style>
.photo-viewport { display: block; width: 100%; overflow: clip; overflow-anchor: none; }
</style>
