---
import SeoHead from '../components/SeoHead.astro';
import {seoPages,routeKey,breadcrumbs,openingHours} from '../lib/seo';
import {responsivePhoto,photoVariant} from '../lib/responsive-photos';
import MenuDialog from '../components/MenuDialog.astro';
import EventsDialog from '../components/EventsDialog.astro';
import ServiceDialogs from '../components/ServiceDialogs.astro';
import ContactDialog from '../components/ContactDialog.astro';
import Arrow from '../components/Arrow.astro';
import content from '../../data/content.json';
import '../styles/global.css';
import '../styles/footer.css';
import '../../wordpress/services.css';
import '../styles/gallery-dialog.css';
import bodoniNormal from '../assets/fonts/bodoni-normal.woff2?url';
import bodoniItalic from '../assets/fonts/bodoni-italic.woff2?url';
import dmSans from '../assets/fonts/dm-sans.woff2?url';
interface Props {title:string;description:string;}
const {title,description}=Astro.props;
const path=Astro.url.pathname;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const internal=(href:string)=>href.startsWith('/')?`${base}${href}`:href;
const routePath=base&&path.startsWith(base)?path.slice(base.length)||'/':path;
const nav=[['Nossa história','/historia/'],['Cardápio',content.menu_url],['Eventos','/eventos/'],['Reservas','/reservas/'],['Rodeio Jardins','/restaurantes/jardins/'],['Rodeio Iguatemi','/restaurantes/iguatemi/']];
const serviceNav=[['Rodeio em casa','/rodeio-em-casa/'],['SAC','/sac/'],['Compliance','/compliance/']];
const desktopRightNav=[['Eventos','/eventos/'],['Delivery','/rodeio-em-casa/'],['Contato','/sac/#fale-com-a-gente']];
const activeNav=(href:string)=>href===content.menu_url?routePath.startsWith('/cardapio'):routePath.startsWith(href);
const site=Astro.site??new URL('http://localhost:4321');
const isPreview=import.meta.env.PUBLIC_LIVE_SITE!=='true';
const pageSeo=seoPages[routeKey(routePath)];
const pageCanonical=new URL(internal(routeKey(routePath)),site);
const pageBreadcrumbs=breadcrumbs(routePath,site,base);
const organization = {
  id: new URL(internal('/#organization'), site).href,
  name: content.client.name,
  url: new URL(internal('/'), site).href,
  logo: new URL(internal('/logos/logo-sem-simbolo.png'), site).href,
  telephone: '+55' + content.client.contact.phone.replace(/\D/g, ''),
  sameAs: ['https://www.instagram.com/rodeiorestaurante/'],
  foundingDate: content.client.founded_year,
};
const currentUnit = content.units.find(unit => routePath.replace(/\/$/, '') === `/restaurantes/${unit.slug}`);
const unitPhoto=currentUnit ? photoVariant([responsivePhoto(currentUnit.slug==='jardins'?'jardinsAcervoBmm17':'iguatemiAcervoDsc9454').variants.filter(v=>v.width<=1600).at(-1)!],import.meta.env.BASE_URL) : undefined;
// Keep the visible briefing address; the individual unit phone remains commercially unconfirmed.
const restaurant = currentUnit ? {
  id: new URL(internal(`/restaurantes/${currentUnit.slug}/#restaurant`), site).href,
  name: `Rodeio ${currentUnit.name}`,
  url: new URL(internal(`/restaurantes/${currentUnit.slug}/`), site).href,
  street: currentUnit.address,
  city: 'São Paulo',
  region: 'SP',
  postalCode: currentUnit.zip,
  country: 'BR',
  reservationUrl: new URL(internal(`/reservas/?unidade=${currentUnit.slug}`), site).href,
  image: new URL(unitPhoto!.src,site).href,
  menu: new URL(internal('/cardapio/'),site).href,
  map: currentUnit.map,
  description: currentUnit.intro,
  hours: openingHours(currentUnit.hours),
} : undefined;
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#FAF7F0"/>
<SeoHead title={pageSeo?.title || title+' | Rodeio Restaurante'} description={pageSeo?.description || description} canonical={pageCanonical} ogImage={unitPhoto ? new URL(unitPhoto.src,site) : new URL(internal('/og.jpg'),site)} favicon="/logos/logo-sem-simbolo.svg" siteName="Rodeio Restaurante" noindex={isPreview || pageSeo?.index===false} nofollow={isPreview} breadcrumbs={pageBreadcrumbs} organization={organization} restaurant={restaurant}/>
<link rel="preload" href={bodoniNormal} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={bodoniItalic} as="font" type="font/woff2" crossorigin/><link rel="preload" href={dmSans} as="font" type="font/woff2" crossorigin/><slot name="head"/></head><body>
<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
<header class:list={['site-header', {'header-home': routePath === '/'}]}>
 <div class="header-left"><nav class="desktop-nav" aria-label="História, cardápio e restaurantes">{[...nav.slice(0,2),['Restaurantes','/restaurantes/']].map(([name,href])=><a href={internal(href)} aria-current={activeNav(href)?'page':undefined}>{name}</a>)}</nav></div>
 <a class="brand header-brand" href={internal('/')}><img src={internal('/logos/logo-sem-simbolo-compacta.webp')} alt="Rodeio — desde 1958" width="420" height="117"/></a>
 <div class="header-right"><nav class="desktop-nav" aria-label="Eventos, delivery e contato">{desktopRightNav.map(([name,href])=><a class:list={{"header-delivery-link":name==='Delivery'}} href={internal(href)} aria-current={activeNav(href)?'page':undefined}>{name}</a>)}</nav><button class="menu-toggle" data-open-menu aria-haspopup="dialog" aria-controls="navigation-dialog" aria-expanded="false"><span>Menu</span><span class="menu-lines" aria-hidden="true"></span></button><noscript><a class="no-script-menu" href="#rodape">Menu</a></noscript></div>
<a class="delivery-whatsapp-float" href={internal('/rodeio-em-casa/')} aria-haspopup="dialog" aria-controls="rodeio-em-casa-dialog"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="5" cy="18" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="19" cy="18" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M5 18h8l-4-8H5m7 0h4l3 8M13 6h4l2 4M3 7h5v4H3V7Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong>Delivery</strong></span></a>
</header>
<dialog id="navigation-dialog" class="navigation-dialog" aria-label="Menu do Rodeio">
 <div class="dialog-top">
  <a class="menu-brand" href={internal('/')}><img src={internal('/logos/logo-sem-simbolo-branca-compacta.webp')} alt="Rodeio — desde 1958" width="420" height="117"/></a>
  <button type="button" class="close-dialog" data-close-menu aria-label="Fechar menu"><span aria-hidden="true">×</span></button>
 </div>
 <div class="menu-content">
 <nav class="menu-primary-nav" aria-label="Navegação principal">
  <a href={internal('/')} aria-current={routePath==='/'?'page':undefined}><span class="menu-label">Home</span><Arrow/></a>
  {[...nav.slice(0,3),['Delivery','/rodeio-em-casa/'],nav[3],['Contato','/sac/#fale-com-a-gente']].map(([name,href])=><a href={internal(href)} aria-current={activeNav(href)?'page':undefined}><span class="menu-label">{name}</span><Arrow/></a>)}
 </nav>
 <div class="menu-houses">
  <p class="menu-section-label" id="menu-houses-title">Nossas casas</p>
  <nav class="menu-houses-nav" aria-labelledby="menu-houses-title">{content.units.map(unit=><a href={internal(`/restaurantes/${unit.slug}/`)} aria-current={activeNav(`/restaurantes/${unit.slug}/`)?'page':undefined}><span>{unit.name}</span><Arrow/></a>)}</nav>
 </div>
 <div class="menu-contact">
  <div class="menu-signoff"><a href="tel:+551134741333">(11) 3474-1333</a></div>
  <a class="menu-instagram" href="https://www.instagram.com/rodeiorestaurante/" target="_blank" rel="noopener noreferrer" aria-label="Instagram do Rodeio (abre em outra aba)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg></a>
 </div>
 </div>
</dialog>
<main id="conteudo" tabindex="-1"><slot/></main>
<footer id="rodape" class="site-footer">
 <div class="footer-body">
 <div class="footer-top footer-details">
  <div class="footer-signoff">
   <a class="brand footer-brand" href={internal('/')}><img src={internal('/logos/logo-sem-simbolo-branca-compacta.webp')} alt="Rodeio — desde 1958" width="420" height="117"/></a>
   <p class="footer-signature">Um clássico<br/><em>que se renova.</em></p>
   <nav class="footer-service-navigation" aria-label="Atendimento e serviços">{serviceNav.map(([name,href])=><a href={internal(href)}>{name}</a>)}</nav>
  </div>
  {content.units.map(unit=><div class:list={["footer-unit",`footer-unit-${unit.slug}`]}><h3><a href={internal('/restaurantes/'+unit.slug+'/')}>Rodeio {unit.name}</a></h3><p>{unit.address}<br/>{unit.district}</p><a class="footer-unit-reserve" href={internal('/reservas/?unidade='+unit.slug)}>Reservar no {unit.name}<Arrow/></a></div>)}
  <div class="footer-contact"><h3>Vamos conversar</h3>
  <div class="footer-social" role="group" aria-label="Contatos Rodeio">
   <a href="tel:+551134741333" aria-label="Ligar para o Rodeio: (11) 3474-1333" title="Telefone: (11) 3474-1333"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.69A2 2 0 0 1 22 16.92Z"/></svg></a>
   <a href="https://www.instagram.com/rodeiorestaurante/" target="_blank" rel="noopener noreferrer" aria-label="Instagram do Rodeio: @rodeiorestaurante (abre em outra aba)" title="Instagram: @rodeiorestaurante"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg></a>
  </div>
   <a href={internal('/reservas/')}>Fazer uma reserva<Arrow/></a>
  </div>
 </div>
 <div class="footer-bottom"><span>© {new Date().getFullYear()} Rodeio Restaurante</span><span class="footer-location">Jardins · Iguatemi · São Paulo</span><a href={internal('/privacidade/')}>Privacidade</a></div>
 </div>
</footer>
<dialog class="gallery-dialog" id="gallery-dialog" aria-label="Fotografia do Rodeio"><button class="close-dialog" data-close-gallery>Fechar <span aria-hidden="true">×</span></button><p id="gallery-status" role="status"></p><div class="gallery-stage" aria-busy="false"><img hidden id="gallery-image" width="1200" height="630" alt=""/></div><div class="gallery-details"><div class="gallery-controls"><button type="button" data-gallery-prev aria-label="Fotografia anterior"><Arrow/></button><span id="gallery-count" aria-live="polite"></span><button type="button" data-gallery-next aria-label="Próxima fotografia"><Arrow/></button></div></div></dialog>
<MenuDialog/>
<EventsDialog/>
<ServiceDialogs/>
<ContactDialog/>
<noscript><style>.menu-toggle,[data-map],#load-reservation,.unit-options{display:none!important}body:has(.full-page-workspace) .site-footer{display:block}</style></noscript>
<script src="../scripts/interactions.ts"></script>
</body></html>
