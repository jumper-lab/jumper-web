---
import Layout from '../layouts/Layout.astro';import Hero from '../components/Hero.astro';import Link from '../components/Link.astro';import content from '../../data/content.json';
const copy=content.pages.events;
import '../styles/interiors.css';
---
<Layout title="Eventos — encontros para guardar" description="Planeje seu encontro, celebração ou evento de negócios no Rodeio. Conheça as casas dos Jardins e Iguatemi e fale com a equipe pelo canal oficial."><Hero eyebrow="" title={copy.title} accent={copy.accent} description={copy.intro} photo="mesa" alt="Mesa posta no Rodeio Jardins, com taças e iluminação intimista" caption="" cta={copy.cta} href="/eventos/orcamento/"/>
<section id="proxima-secao" class="event-occasions interior-section" aria-labelledby="event-occasions-title"><div class="wrap">
  <div class="interior-section-heading"><div><h2 id="event-occasions-title">Cada encontro,<br/><em>uma ocasião.</em></h2></div><p>Reuniões de negócios, encontros em família e celebrações: converse com a equipe sobre o que você está planejando.</p></div>
  <div class="occasion-list">
    <article class="event-detail occasion"><h3>Encontros<br/><em>em família</em></h3><p>Uma mesa para reunir as pessoas que fazem parte da sua história.</p></article>
    <article class="event-detail occasion"><h3>Negócios<br/><em>à mesa</em></h3><p>O restaurante como ponto de encontro para uma conversa que pede tempo e atenção.</p></article>
    <article class="event-detail occasion"><h3>Ocasiões<br/><em>especiais</em></h3><p>Aniversários e outras celebrações merecem ser pensados com cuidado. Consulte a equipe sobre as possibilidades para a sua ocasião.</p></article>
  </div>
  <div class="occasion-action"><Link href="/eventos/orcamento/">Solicitar orçamento</Link></div>
</div></section>
</Layout>
