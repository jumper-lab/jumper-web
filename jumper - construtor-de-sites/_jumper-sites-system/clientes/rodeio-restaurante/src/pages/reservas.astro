---
import Photo from '../components/Photo.astro';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ReservationDialog from '../components/ReservationDialog.astro';
import content from '../../data/content.json';
import '../styles/reservations.css';
---
<Layout title="Reservas — escolha sua mesa" description="Reserve uma mesa no Rodeio Jardins ou Iguatemi. Escolha sua unidade e consulte disponibilidade pelo sistema oficial de reservas da casa.">
<section class="reservation-screen" id="escolher-unidade" aria-labelledby="reservation-heading" tabindex="0">
  <div class="reservation-content">
    <header class="reservation-introduction">
      <h1 id="reservation-heading">Onde vamos <em>nos encontrar?</em></h1>
      <p>Selecione Jardins ou Iguatemi para consultar datas e horários.</p>
    </header>
    <div class="reservation-houses">
      {content.units.map((unit,i)=><article class="reservation-house" id={`reservar-${unit.slug}`} data-reservation-card={unit.slug} aria-labelledby={`reservation-heading-${unit.slug}`}>
        <div class="reservation-house-photo"><Photo name={unit.slug==='jardins'?'jardinsAcervoBmm17':'iguatemiAcervoDsc9454'} alt={`O salão do Rodeio ${unit.name}`} maxWidth={960} sizes="(max-width: 759px) calc(100vw - 48px), (max-width: 1199px) 45vw, 580px" eager={i===0}/></div>
        <div class="reservation-house-information">
          <div class="reservation-house-description">
            <h2 id={`reservation-heading-${unit.slug}`}>Rodeio {unit.name}</h2>
            <address>{unit.address}<span>{unit.district}</span></address>
          </div>
          <a class="action reservation-house-action" href={unit.widget} data-reservation-unit={unit.slug} aria-haspopup="dialog" aria-controls={`reservation-${unit.slug}-dialog`}>Reservar no {unit.name}<Arrow/></a>
        </div>
      </article>)}
    </div>
    <div class="reservation-assistance">
      <p>A disponibilidade e a confirmação são informadas pelo sistema de reservas.</p>
      <a href="tel:+551134741333"><span>Precisa de ajuda?</span> (11) 3474-1333</a>
      <noscript><p>Reservas nas páginas oficiais: {content.units.map(unit=><a href={unit.reservation}>{unit.name}</a>)}</p></noscript>
    </div>
  </div>
</section>
{content.units.map(unit=><ReservationDialog unit={unit}/>)}
</Layout>
<script src="../scripts/reservations.ts"></script>
