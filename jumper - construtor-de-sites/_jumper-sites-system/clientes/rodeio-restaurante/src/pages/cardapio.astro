---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import Link from '../components/Link.astro';
import content from '../../data/content.json';
import '../styles/interiors.css';
const copy=content.pages.menu;
---
<Layout title="Cardápio — os clássicos do Rodeio" description={copy.description}>
  <Hero eyebrow="Cardápio · Rodeio" title={copy.title} accent={copy.accent} description={copy.intro} photo="cardapioHero" alt="Carne e arroz servidos à mesa no Rodeio" caption="Gastronomia Rodeio" cta={copy.cta} href={content.menu_url} secondary="Reservar uma mesa" secondaryHref="/reservas/"/>
  <section id="proxima-secao" class="wrap interior-section menu-editorial" aria-labelledby="menu-editorial-title">
    <div class="menu-editorial-copy">
      <p class="eyebrow">Da nossa história, à sua mesa</p>
      <h2 id="menu-editorial-title">Os sabores<br/><em>que ficam.</em></h2>
      <p>{copy.description}</p>
      <ul class="menu-signatures"><li><span>Picanha fatiada</span><small>Clássico do Rodeio</small></li><li><span>Arroz Rodeio</span><small>O tradicional Biro-Biro</small></li></ul>
      <Link href={content.menu_url} primary>{copy.cta}</Link>
    </div>
    <figure><Photo name="carneDetalhe" sizes="(max-width:759px) 88vw, 44vw" alt="Detalhe de um prato de carne do Rodeio"/><figcaption>Os clássicos, em cada detalhe.</figcaption></figure>
  </section>
  <section class="menu-finish interior-section"><div class="wrap menu-finish-layout">
    <figure><Photo name="sobremesaServico" sizes="(max-width:759px) 76vw, 32vw" alt="Sobremesa do Rodeio finalizada em uma taça"/><figcaption>Para encerrar o encontro.</figcaption></figure>
    <div><p class="eyebrow">Para o seu próximo encontro</p><h2>Escolha a casa.<br/><em>Reserve sua mesa.</em></h2><p>Rodeio Jardins ou Rodeio Shopping Iguatemi.</p><Link href="/reservas/">Reservar uma mesa</Link></div>
  </div></section>
</Layout>
