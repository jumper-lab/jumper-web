---
import Layout from '../layouts/Layout.astro';import Hero from '../components/Hero.astro';import Photo from '../components/Photo.astro';import Link from '../components/Link.astro';
const milestones=[{year:'1958',title:'Tudo começa na Haddock Lobo.',text:'Em 1958, o Rodeio começa sua história na Rua Haddock Lobo, quando os Jardins ainda davam seus primeiros passos como um dos endereços mais importantes de São Paulo.'},{year:'1959',title:'Uma história de família.',text:'Um ano depois, a família Macedo assume o restaurante. Roberto Macedo, então jovem administrador, passa a conduzir a unidade e, ao longo dos anos, transforma sua identidade. O Rodeio cresce, ganha novos serviços, incorpora vinhos e carnes especiais e ajuda a criar uma nova maneira de viver uma churrascaria em São Paulo.'},{year:'1986',title:'A próxima geração, à mesa.',text:'Em 1986, Silvia Macedo começa a trabalhar ao lado do pai. Com o tempo, torna-se parte fundamental da condução do restaurante, dando continuidade à trajetória da família.'},{year:'2001',title:'Certificação de qualidade.',text:'Em 2001, o Rodeio recebe uma certificação de qualidade, reforçando o cuidado que sempre esteve presente em sua trajetória.'},{year:'2011',title:'O Rodeio chega ao Iguatemi.',text:'Dez anos depois, em 2011, é inaugurada a unidade no Shopping Iguatemi, levando a tradição da churrascaria a um dos principais polos de São Paulo.'},{year:'2026',title:'Um clássico que se renova.',text:'Quase sete décadas depois, o Rodeio continua na Haddock Lobo. Em 2026, a história ganha um novo endereço, a poucos metros de onde tudo começou, mantendo a essência que acompanha a casa desde 1958.'}];
import '../styles/interiors.css';
---
<Layout title="Nossa história — desde 1958" description="Da Haddock Lobo à história da família Macedo: conheça a trajetória do Rodeio, seus clássicos à mesa e os encontros que começaram em 1958."><Hero eyebrow="Nossa história · São Paulo" title="A mesa muda." accent="A história fica." description="Desde 1958, o Rodeio faz parte das histórias de São Paulo. E de quem escolhe estar à nossa mesa." photo="historiaHero" alt="Luz de abajur e poltrona no ambiente contemporâneo do Rodeio Jardins" caption="O acolhimento da casa · Jardins"/>
<section id="proxima-secao" class="wrap interior-section history-chapter" aria-labelledby="history-chapter-title">
  <div class="history-chapter-heading">
    <p class="eyebrow">1958 — hoje</p>
    <h2 id="history-chapter-title">Uma casa.<br/><em>Muitas histórias.</em></h2>
    <p>Uma trajetória breve, mas feita de família, novos serviços, vinhos, carnes especiais e de uma maneira própria de receber à mesa.</p>
    <span class="history-date-note">Haddock Lobo, São Paulo</span>
  </div>
  <div class="history-timeline">
    {milestones.map(m=><article class="timeline-item history-milestone"><span class="timeline-date">{m.year}</span><div><h3>{m.title}</h3><p>{m.text}</p></div></article>)}
  </div>
</section>
<section class="history-archive" aria-labelledby="history-archive-title">
  <div class="wrap history-archive-grid">
    <div class="history-archive-intro">
      <p class="eyebrow">Acervo Rodeio</p>
      <h2 id="history-archive-title">Uma história<br/>que se <em>vê.</em></h2>
      <p>Entre a fachada, os salões e as pessoas que fizeram parte da casa, cada fotografia preserva um capítulo do Rodeio.</p>
    </div>
    <figure class="history-archive-facade"><Photo name="historiaFachadaAcervo" sizes="(max-width:759px) 100vw, 52vw" alt="Registro em preto e branco da fachada histórica do Rodeio na Rua Haddock Lobo"/><figcaption>Uma das primeiras fachadas do Rodeio na Haddock Lobo.</figcaption></figure>
    <figure class="history-archive-family"><Photo name="historiaFamilia" sizes="(max-width:759px) 88vw, 38vw" alt="Registro de acervo de duas pessoas à mesa no Rodeio"/><figcaption>O encontro e o cuidado que atravessam gerações.</figcaption></figure>
    <div class="history-archive-note"><span>Desde 1958</span><p>O tempo transforma a cidade. A essência da casa permanece à mesa.</p></div>
    <figure class="history-archive-portrait"><Photo name="historiaRetrato" sizes="(max-width:759px) 76vw, 28vw" alt="Registro de acervo de um cliente no salão do Rodeio"/><figcaption>Um retrato da vida que acontece no Rodeio.</figcaption></figure>
  </div>
</section>
<section class="history-taste interior-section">
  <div class="wrap history-taste-grid">
    <figure><Photo name="origem" sizes="(max-width:759px) 74vw, 30vw" alt="Registro de acervo da antiga entrada do Rodeio e seu letreiro"/><figcaption>Fotografia preservada no acervo do Rodeio.</figcaption></figure>
    <div class="history-taste-copy"><p class="eyebrow">Clássicos que nasceram aqui</p><h2>A história<br/>também tem <em>sabor.</em></h2><p>Foi nessa trajetória que nasceram alguns dos grandes clássicos da casa, como a picanha fatiada e o arroz Rodeio, o tradicional Biro-Biro. Sabores que continuam presentes em cada novo encontro.</p><Link href="/cardapio/">Conhecer os clássicos da casa</Link></div>
  </div>
</section>
</Layout>
