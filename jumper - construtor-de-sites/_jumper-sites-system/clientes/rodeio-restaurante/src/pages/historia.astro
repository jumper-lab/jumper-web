---
import Layout from '../layouts/Layout.astro';import Photo from '../components/Photo.astro';import Link from '../components/Link.astro';
import content from '../../data/content.json';
const copy=content.pages.history;
const milestones=copy.milestones;
import '../styles/interiors.css';
---
<Layout title="Nossa história — desde 1958" description="Da Haddock Lobo à história da família Macedo: conheça a trajetória do Rodeio, seus clássicos à mesa e os encontros que começaram em 1958.">
<section id="proxima-secao" class="wrap interior-section history-chapter page-without-banner" aria-labelledby="history-chapter-title">
  <div class="history-chapter-heading">
    <h1 id="history-chapter-title">Uma história<br/>que atravessa <em>gerações.</em></h1>
  </div>
  <ol class="history-timeline" aria-label="Linha do tempo do Rodeio">
    {milestones.map(m=><li class="timeline-item history-milestone"><span class="timeline-date">{m.year}</span><div><h2>{m.title}</h2><p>{m.text}</p>{m.year==='1959'&&<p>{copy.classics}</p>}</div></li>)}
  </ol>
</section>
<section class="history-archive" aria-labelledby="history-archive-title">
  <div class="wrap history-archive-grid">
    <div class="history-archive-intro">
      <p class="eyebrow">Acervo Rodeio</p>
      <h2 id="history-archive-title">Uma história<br/>que se <em>vê.</em></h2>
      <p>Entre a fachada, os salões e as pessoas que fizeram parte da casa, cada fotografia preserva um capítulo do Rodeio.</p>
    </div>
    <figure class="history-archive-facade"><Photo name="historiaFachadaAcervo" sizes="(max-width:759px) 100vw, 52vw" alt="Registro em preto e branco da fachada histórica do Rodeio na Rua Haddock Lobo"/><figcaption>A fachada histórica do Rodeio na Haddock Lobo.</figcaption></figure>
    <figure class="history-archive-family"><Photo name="historiaFamilia" sizes="(max-width:759px) 88vw, 38vw" alt="Registro de acervo de duas pessoas à mesa no Rodeio"/><figcaption>O encontro e o cuidado que atravessam gerações.</figcaption></figure>
    <div class="history-archive-note"><span>Desde 1958</span><p>O tempo transforma a cidade. A essência da casa permanece à mesa.</p></div>
    <figure class="history-archive-portrait"><Photo name="historiaRetrato" sizes="(max-width:759px) 76vw, 28vw" alt="Registro de acervo de um cliente no salão do Rodeio"/><figcaption>Um retrato da vida que acontece no Rodeio.</figcaption></figure>
  </div>
</section>
<section class="history-taste interior-section">
  <div class="wrap history-taste-grid">
    <figure><Photo name="origem" sizes="(max-width:759px) 74vw, 30vw" alt="Registro de acervo da antiga entrada do Rodeio e seu letreiro"/><figcaption>Fotografia preservada no acervo do Rodeio.</figcaption></figure>
    <div class="history-taste-copy"><p class="eyebrow">Clássicos que nasceram aqui</p><h2>A história<br/>também tem <em>sabor.</em></h2><Link href={content.menu_url}>{content.pages.menu.cta}</Link></div>
  </div>
</section>
</Layout>
