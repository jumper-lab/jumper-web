---
import RestaurantGallery from '../../components/RestaurantGallery.astro';
import ReservationDialog from '../../components/ReservationDialog.astro';
import {restaurantGallerySelections} from '../../lib/restaurant-galleries';
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';
import content from '../../../data/content.json';
import '../../styles/interiors.css';
export function getStaticPaths(){return content.units.map(unit=>({params:{unidade:unit.slug},props:{unit}}));}
const {unit}=Astro.props;
const isJardins=unit.slug==='jardins';
const otherUnit = isJardins ? {slug:'iguatemi',name:'Iguatemi'} : {slug:'jardins',name:'Jardins'};
const galleryPhotos=restaurantGallerySelections[unit.slug];
---
<Layout title={`Rodeio ${unit.name} — endereço e reservas`} description={`Conheça o Rodeio ${unit.name}, em ${unit.address}, São Paulo. Veja os ambientes, consulte os horários e planeje sua reserva.`}>

 <section id="proxima-secao" class="wrap interior-section visit-details page-without-banner" aria-labelledby="unit-title">
  <nav class="unit-page-navigation" aria-label="Navegação entre restaurantes">
   <Link href="/restaurantes/" class="unit-back">Restaurantes</Link>
   <Link href={`/restaurantes/${otherUnit.slug}/`} class="unit-other">Conhecer {otherUnit.name}</Link>
  </nav>
  <div class="visit-heading"><h1 id="unit-title" class="restaurant-name"><span>Rodeio</span><em>{unit.name}</em></h1></div>
  <div class="visit-information">
   <div class="visit-address"><h3>Endereço</h3><address>{isJardins&&<span class="house-new-address">Novo endereço</span>}{unit.address}<br/>{unit.district}<br/><span>CEP {unit.zip}</span></address><Link href={unit.map}>Ver como chegar</Link></div>
   <div class="visit-hours"><h3>Horários de funcionamento</h3><ul>{content.hours.map(hour=><li><span>{hour.split(': ')[0]}</span><strong>{hour.split(': ').slice(1).join(': ')}</strong></li>)}</ul></div>
   <div class="visit-reservation">
    <div><h3>Reservas</h3><p>Escolha a data e consulte os horários disponíveis no sistema de reservas.</p></div>
    <div class="visit-reservation-actions"><Link href={unit.widget} primary>Reservar no {unit.name}</Link><Link href={content.menu_url}>{content.pages.menu.cta}</Link></div>
   </div>
  </div>
 </section>
 <section id="galeria" class="wrap interior-section visit-gallery-section" aria-labelledby="gallery-heading">
  <div class="interior-section-heading"><h2 id="gallery-heading">Um olhar<br/><em>pela casa.</em></h2></div>
  <RestaurantGallery photos={galleryPhotos} unitName={unit.name} galleryId={`${unit.slug}-gallery-grid`} pageSize={6} detailWidth={isJardins?1600:2400} detailQuality={isJardins?55:68}/>
 </section>
<ReservationDialog unit={unit}/>
</Layout>
