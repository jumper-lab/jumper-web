---
import GalleryPhoto from '../../components/GalleryPhoto.astro';
import {restaurantGalleries} from '../../lib/restaurant-galleries';
import Layout from '../../layouts/Layout.astro';import Hero from '../../components/Hero.astro';import Link from '../../components/Link.astro';import content from '../../../data/content.json';
export function getStaticPaths(){return content.units.map(unit=>({params:{unidade:unit.slug},props:{unit}}));}
const {unit}=Astro.props;const galleryPhotos=restaurantGalleries[unit.slug];const mapURL='https://maps.google.com/maps?q='+encodeURIComponent(unit.address+', São Paulo')+'&output=embed';
import '../../styles/interiors.css';
---
<Layout title={`Rodeio ${unit.name} — endereço e reservas`} description={`Conheça o Rodeio ${unit.name}, em ${unit.address}, São Paulo. Veja os ambientes, consulte os horários e planeje sua reserva.`}><Hero eyebrow={`Nossas casas · ${unit.name}`} title={unit.name==='Jardins'?'A nossa história,':'Seu encontro,'} accent={unit.name==='Jardins'?'sempre presente.':'no Iguatemi.'} description={unit.intro} photo={unit.slug==='jardins'?'jardinsHero':'iguatemiHero'} alt={`Ambiente do Rodeio ${unit.name}, com mesas postas e madeira no teto`} caption={`Rodeio ${unit.name}`} cta={`Reservar no ${unit.name}`} href={`/reservas/?unidade=${unit.slug}`}/>
<section id="proxima-secao" class="wrap interior-section visit-details" aria-labelledby="visit-title"><div class="visit-heading"><p class="eyebrow">Rodeio {unit.name}</p><h2 id="visit-title">Planeje<br/><em>sua visita.</em></h2><p>Encontre o endereço, os horários de funcionamento e o acesso às reservas.</p></div>
  <div class="visit-information"><div class="visit-address"><h3>Endereço</h3><address>{unit.address}<br/>{unit.district}<br/><span>CEP {unit.zip}</span></address><Link href={unit.map}>Ver como chegar</Link></div><div class="visit-hours"><h3>Horários de funcionamento</h3><ul>{content.hours.map(hour=><li><span>{hour.split(': ')[0]}</span><strong>{hour.split(': ').slice(1).join(': ')}</strong></li>)}</ul></div><div class="visit-reservation"><div><h3>Reservas</h3><p>Escolha a data e consulte os horários disponíveis no sistema de reservas.</p></div><Link href={`/reservas/?unidade=${unit.slug}`} primary>Reservar no {unit.name}</Link></div></div>
</section>
<section class="visit-map"><div class="wrap"><div class="visit-map-heading"><div><p class="eyebrow">O caminho até a casa</p><p>{unit.address} · São Paulo</p></div><button class="map-button" data-map={mapURL} data-title={`Mapa do Rodeio ${unit.name}`}>Carregar mapa do {unit.name}</button></div><div id="map-slot" class="map-slot"></div></div></section>
<section id="galeria" class="wrap interior-section visit-gallery-section" aria-labelledby="gallery-heading"><div class="interior-section-heading"><div><p class="eyebrow">{galleryPhotos.length} fotografias · Rodeio {unit.name}</p><h2 id="gallery-heading">Um olhar<br/><em>pela casa.</em></h2></div><p>Explore os ambientes do Rodeio {unit.name}. Selecione uma foto para ampliar e navegar pela galeria.</p></div><div class="gallery-grid visit-gallery restaurant-gallery">{galleryPhotos.map(photo=><GalleryPhoto name={photo.name} alt={`${photo.caption} · Rodeio ${unit.name}`} caption={photo.caption} sizes="(max-width:599px) calc(100vw - 48px), (max-width:959px) 44vw, 29vw"/>)}</div></section>
</Layout>
