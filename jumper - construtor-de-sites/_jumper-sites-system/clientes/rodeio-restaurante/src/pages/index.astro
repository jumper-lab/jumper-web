---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import Link from '../components/Link.astro';
import UnitList from '../components/UnitList.astro';
import content from '../../data/content.json';
const copy=content.pages.home;
import '../styles/home.css';
---
<Layout title="Um clássico que se renova, desde 1958" description="Conheça o Rodeio: carnes, cozinha e acolhimento desde 1958 em São Paulo. Descubra nossas casas nos Jardins e no Iguatemi e reserve sua mesa.">
  <Hero home eyebrow="Restaurante · São Paulo · desde 1958" title={copy.title} accent={copy.accent} description={copy.intro} photo="homeBifeAcervo2024" alt="Corte de carne grelhada servido com arroz no Rodeio" caption="O corte, no centro da experiência" secondary={copy.menu_cta} secondaryHref="/cardapio/"/>
  <section id="a-mesa" class="home-experience wrap">
    <div class="experience-copy"><p class="eyebrow">01 / A experiência Rodeio</p><h2>Uma história.<br/><em>Um novo momento.</em></h2><div class="experience-body"><p>{copy.description}</p><Link href="#nossas-unidades">{copy.units_cta}</Link></div></div>
    <figure class="experience-photo"><Photo name="jardinsNovoEncontro" sizes="(max-width:759px) 85vw, 42vw" alt="Novo Rodeio Jardins: salão com clientes à mesa, jardim e iluminação acolhedora"/><figcaption><span>O novo Rodeio Jardins.</span><span>Haddock Lobo, 1448</span></figcaption></figure>
  </section>
  <section id="classicos" class="home-cuisine" aria-labelledby="cuisine-title"><div class="wrap cuisine-layout">
    <p class="eyebrow cuisine-number">02 / Clássicos à mesa</p>
    <div class="cuisine-heading"><h2 id="cuisine-title">Os clássicos<br/><em>do Rodeio.</em></h2><div class="cuisine-intro"><p>{content.pages.menu.intro}</p><Link href="/cardapio/">{copy.menu_cta}</Link></div></div>
    <figure class="cuisine-main"><Photo name="picanha" sizes="(max-width:759px) 90vw, 48vw" alt="Prato de carne do Rodeio servido sobre uma mesa com toalha branca"/><figcaption>À mesa, os sabores da casa.</figcaption></figure>
    <figure class="cuisine-detail"><Photo name="sobremesa" sizes="(max-width:759px) 90vw, 40vw" alt="Sobremesa do Rodeio servida em prato escuro sobre uma mesa de madeira"/><figcaption>Um último sabor. Mais uma conversa.</figcaption></figure>
  </div></section>
  <section id="nossas-unidades" class="home-houses wrap"><div class="houses-heading"><p class="eyebrow">03 / Nossas casas</p><h2>Dois endereços.<br/><em>O mesmo Rodeio.</em></h2><p>Nos Jardins ou no Shopping Iguatemi, escolha onde será seu próximo encontro em São Paulo.</p></div><UnitList/></section>
  <section class="home-memory"><div class="wrap memory-layout"><figure><Photo name="historia" sizes="(max-width:759px) 90vw, 48vw" alt="Fotografia de acervo da fachada do Rodeio na Rua Haddock Lobo"/><figcaption>A casa na Haddock Lobo · acervo Rodeio</figcaption></figure><div class="memory-editorial"><p class="eyebrow">04 / Uma história de família</p><span class="archive-date" aria-hidden="true">1958</span><h2>São Paulo muda.<br/>Nossas histórias<br/><em>continuam.</em></h2><p>Desde 1959, a família Macedo conduz o Rodeio. Uma trajetória que passa por Roberto, Silvia e pela vida da casa na Haddock Lobo.</p><Link href="/historia/">Percorrer nossa história</Link></div></div></section>
  <section class="home-occasion wrap"><figure><Photo name="mesaDetalhe" sizes="(max-width:759px) 90vw, 38vw" alt="Mesa posta no Rodeio com iluminação acolhedora para um encontro"/></figure><div><p class="eyebrow">À mesa cabe uma celebração</p><h2>Um endereço<br/>para celebrar<br/><em>momentos especiais.</em></h2><div class="occasion-actions"><Link href="/eventos/" primary>Planejar um evento</Link></div></div></section>
</Layout>
