---
import FullPageWorkspace from '../../components/FullPageWorkspace.astro';
import content from '../../../data/content.json';
import '../../styles/pdf-page-zoom.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const pages=[1,2,3,4,5];
---
<FullPageWorkspace title="Cardápio Rodeio" back="/cardapio/" download={`${base}${content.menu_url}`}>
  <div class="workspace-pdf-pages" aria-label="Páginas do cardápio Rodeio">
    {pages.map(page=><div class="pdf-page-zoom" data-pdf-page><img src={`${base}/cardapio-paginas/pagina-${page}.webp`} alt={`Página ${page} de ${pages.length} do cardápio Rodeio`} width="1555" height="2200" loading={page===1?'eager':'lazy'} decoding="async" draggable="false"/></div>)}
  </div>
</FullPageWorkspace>
<script src="../../scripts/pdf-page-zoom.ts"></script>
