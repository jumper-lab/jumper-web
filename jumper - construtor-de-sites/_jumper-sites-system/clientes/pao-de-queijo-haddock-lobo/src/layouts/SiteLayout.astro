---
import { content, href, imageData } from '../lib/site';
import Icon from '../components/Icon.astro';
import NavPrint from '../components/NavPrint.astro';
import '../styles/global.css';
import '../styles/atelier.css';
import '../styles/page-hero.css';
import '../styles/mobile-menu.css';
import dinFont from '../assets/fonts/din-condensed-bold.woff2?url';
import bodyFont from '../assets/fonts/poppins-regular.woff2?url';
const { title, description, current = '', image = 'hero-pao', noindex: requestedNoindex = false } = Astro.props;
const immersive=current==='home';
const fullScreen=['sobre','lojas','menu'].includes(current);
const origin = Astro.site || new URL('https://paodequeijohaddocklobo.com.br');
const noindex = requestedNoindex || origin.hostname === 'site.jumper.dev.br';
const canonical = new URL(Astro.url.pathname, origin);
const og = new URL(imageData(image).src, origin).href;
const nav = [{label:'Nossa história',url:'/sobre/',id:'sobre'},{label:'Cardápio',url:'/menu/',id:'menu'},{label:'Eventos',url:'/#eventos',id:'eventos'},{label:'Contato',url:'/#contatos',id:'contato'}];
const businesses = content.locations.map(store=>({ '@type':'CafeOrCoffeeShop','@id':new URL(href(`/lojas/#${store.id}`),origin).href,name:`Pão de Queijo Haddock Lobo — ${store.name}`,telephone:store.tel,url:new URL(href('/lojas/'),origin).href,image:new URL(imageData(store.image).src,origin).href,servesCuisine:'Cafeteria brasileira',address:{'@type':'PostalAddress',...(store.id!=='sirio'?{streetAddress:store.address}:{}),addressLocality:store.city,addressRegion:store.region.toUpperCase(),addressCountry:'BR'},hasMap:store.map}));
const schema = {'@context':'https://schema.org','@graph':[{'@type':'Organization',name:content.client,url:new URL(href('/'),origin).href,foundingDate:'1968',logo:new URL(href('/brand/logo-navy.png'),origin).href,sameAs:[content.instagram]},...businesses]};
---
<!doctype html><html lang="pt-BR"><head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title} | Pão de Queijo Haddock Lobo</title><meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/><meta name="theme-color" content="#13273D"/>
  {noindex && <meta name="robots" content="noindex,follow"/>}
  <meta property="og:type" content="website"/><meta property="og:locale" content="pt_BR"/><meta property="og:site_name" content={content.client}/><meta property="og:title" content={`${title} | ${content.client}`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={og}/><meta property="og:image:alt" content={imageData(image).alt || content.client}/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={og}/>
  <link rel="icon" type="image/png" href={href('/favicon.png')}/><link rel="apple-touch-icon" href={href('/favicon.png')}/>
  <link rel="preload" as="font" type="font/woff2" href={dinFont} crossorigin="anonymous"/><link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin="anonymous"/>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</head><body id="topo" class:list={[{'home-page':current==='home','immersive-page':immersive,'full-screen-page':fullScreen}]}>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <header class:list={['site-header',{'is-over-hero':immersive}]}><div class="header-inner">
    <a class="brand" href={href('/')} aria-label="Pão de Queijo Haddock Lobo, início"><img class="brand-dark" src={href('/brand/logo-navy.png')} alt="Pão de Queijo Haddock Lobo — desde 1968" width="580" height="450" fetchpriority={immersive?'auto':'high'}/>{immersive && <img class="brand-light" src={href('/brand/logo-white.png')} alt="" width="580" height="450" fetchpriority="high"/>}</a>
    <nav class="desktop-nav" aria-label="Principal">{nav.map((link,index)=><a class="print-link" data-nav-chapter={`0${index+1}`} aria-label={link.label} href={href(link.url)} aria-current={current===link.id?'page':undefined}><NavPrint label={link.label}/></a>)}<a class="button nav-button" href={href('/lojas/')} aria-current={current==='lojas'?'page':undefined}><NavPrint label="Nossas lojas"/></a></nav>
    <button class="mobile-menu-button" id="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="mobile-navigation">Menu <Icon name="menu" size={24}/></button>
  </div></header>
  <noscript><nav class="no-js-nav" aria-label="Principal"><a href={href('/')}>Início</a><a href={href('/sobre/')}>História</a><a href={href('/menu/')}>Cardápio</a><a href={href('/lojas/')}>Lojas</a><a href={href('/#contatos')}>Contato</a></nav></noscript>
  <dialog class="mobile-navigation" id="mobile-navigation" aria-labelledby="mobile-menu-title"><div class="mobile-navigation-top"><p id="mobile-menu-title" class="eyebrow">A sua pausa começa aqui</p><button type="button" class="icon-button" data-close-menu aria-label="Fechar menu"><Icon name="close"/></button></div><nav aria-label="Principal no celular"><a href={href('/')} data-nav-chapter="00" aria-label="Início" aria-current={current==='home'?'page':undefined}><NavPrint label="Início"/></a>{nav.map((link,index)=><a href={href(link.url)} data-nav-chapter={`0${index+1}`} aria-label={link.label} aria-current={current===link.id?'page':undefined}><NavPrint label={link.label}/></a>)}<a href={href('/lojas/')} data-nav-chapter="05" aria-label="Nossas lojas" aria-current={current==='lojas'?'page':undefined}><NavPrint label="Nossas lojas"/></a></nav><p class="handwritten">desde 1968, uma pausa boa.</p></dialog>
  <main id="conteudo"><slot/></main>
  <footer class="site-footer" id={current==='home'?'rodape':'contatos'}><div class="container"><div class="footer-main"><div class="footer-message"><p class="eyebrow">A gente se encontra por aqui.</p><p class="footer-display">ATÉ A PRÓXIMA<br/>PAUSA.</p><a class="text-link" href={href('/lojas/')}>Encontrar uma loja</a></div><div class="footer-details"><img class="footer-brand" src={href('/brand/logo-navy.png')} alt="Pão de Queijo Haddock Lobo — desde 1968" width="580" height="450" loading="lazy"/><a class="footer-email" href={`mailto:${content.conversion.public_email}`}>{content.conversion.public_email}</a><a class="text-link" href={content.instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram"/> Acompanhar no Instagram</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Pão de Queijo Haddock Lobo</span><nav aria-label="Navegação do rodapé"><a href={href('/sobre/')}>História</a><a href={href('/menu/')}>Cardápio</a><a href={href('/lojas/')}>Lojas</a><a href={href('/#eventos')}>Eventos</a><a href={href('/#contatos')}>Contato</a></nav><a class="back-to-top" href="#topo" aria-label="Voltar ao topo"> Ao topo</a></div></div></footer>
  <dialog class="photo-dialog" id="photo-dialog" aria-labelledby="photo-caption"><button type="button" class="photo-dialog-close icon-button" data-close-photo aria-label="Fechar foto ampliada"><Icon name="close" size={24}/></button><div class="photo-dialog-frame"><img id="expanded-photo" alt="" width="1800" height="1800" hidden/></div><p id="photo-load-status" role="status" hidden></p><p id="photo-caption"></p></dialog>
  <script src="../scripts/site.ts"></script>
</body></html>
