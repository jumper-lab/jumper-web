---
import SiteLayout from '../layouts/SiteLayout.astro';
import MenuPhoto from '../components/MenuPhoto.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import FoodIcon from '../components/FoodIcon.astro';
import '../styles/menu-highlight.css';
import { content, href, price } from '../lib/site';
---
<SiteLayout title="Cardápio — cafés, salgados, doces e pão de queijo" description="Explore o cardápio da Haddock Lobo: pão de queijo, salgados, tortas, sanduíches, doces, cafés, bebidas e opções para levar para casa." current="menu" image="mesa">
  <PageHero variant="menu" image="mesa" titleId="menu-title" lines={['UM CLÁSSICO.','MUITOS FAVORITOS.']} eyebrow="O nosso cardápio" description="O de sempre ou uma nova companhia? Encontre o sabor da sua próxima pausa." actionLabel="Explorar o cardápio" actionHref="#cardapio" note="vale deixar espaço para o doce." caption="Uma mesa. Muitas boas escolhas."/>
  <section class="menu-section section-space" id="cardapio"><div class="container"><div class="menu-toolbar"><div class="menu-catalog-intro"><div class="menu-catalog-kicker"><FoodIcon name="carta" size={38}/><p class="eyebrow">Cardápio da casa</p></div><h2>O QUE VAI SER HOJE?</h2><p class="menu-catalog-help">Escolha uma categoria ou busque o seu favorito.</p></div><div class="menu-search"><label for="menu-search-input">Buscar no cardápio</label><div class="search-input-wrap"><Icon name="search"/><input type="search" id="menu-search-input" placeholder="Pão de queijo, café, quindim…" autocomplete="off"/><button type="button" data-clear-search aria-label="Limpar busca" hidden><Icon name="close" size={18}/></button></div></div></div><p class="menu-note">{content.menu.note}</p><div class="menu-layout"><aside class="menu-index"><p class="menu-index-caption">Escolha uma categoria<span>Deslize para explorar</span></p><nav aria-label="Categorias do cardápio">{content.menu.categories.map((category,index)=><a href={`#${category.id}`} data-category-link={category.id}><span class="menu-category-number" aria-hidden="true">0{index+1}</span><FoodIcon name={category.id} size={28}/><span class="menu-category-label">{category.name}</span></a>)}</nav><p>Uma dúvida ou pedido?<br/><a class="text-link" href={href('/lojas/')}>Fale com a sua loja</a></p></aside><div class="menu-content"><p class="search-status sr-only" role="status" data-menu-status>{content.menu.item_count} itens no cardápio</p><div class="menu-empty" data-menu-empty hidden><p class="handwritten">Vamos tentar outro favorito?</p><h3>Nenhum item encontrado.</h3><p>Busque pelo nome do produto ou por um ingrediente.</p><button type="button" class="button" data-reset-menu>Ver todo o cardápio</button></div>
      {content.menu.categories.map((category,index)=><section class="menu-category" id={category.id} data-menu-category={category.id} aria-labelledby={`heading-${category.id}`}><span class="legacy-anchor" id={category.id === 'tortas' ? 'sopa' : category.id === 'bebidas' ? 'colageno' : undefined} aria-hidden="true"></span><div class="menu-category-heading"><div><p class="eyebrow"><FoodIcon name={category.id} size={28}/><span>0{index+1} / Cardápio</span></p><h3 id={`heading-${category.id}`}>{category.name}</h3><p>{category.intro}</p></div>{category.image && <MenuPhoto name={category.image} category={category.name} categoryId={category.id}/>}</div><ul class="menu-items">{category.items.map(item=><li data-menu-item data-search={`${item.name} ${item.description}`}><div><h4>{item.name}</h4>{item.description && <p>{item.description}</p>}</div><span class="menu-price">{price(item.price)}</span></li>)}</ul></section>)}
    </div></div><div class="menu-closing"><img src={href('/brand/symbol-navy.png')} alt="" width="198" height="189" loading="lazy"/><div><h3>Deu vontade?</h3><p>Escolha uma loja ou peça pelos nossos canais de delivery.</p></div><a class="button" href={href('/lojas/')}>Encontrar uma loja</a><div class="menu-delivery-actions" role="group" aria-label="Pedir pelos apps de delivery"><a class="text-link menu-delivery-link" href={content.delivery.ifood_url} target="_blank" rel="noopener noreferrer" aria-label="Pedir no iFood (abre em nova aba)"><img src={href('/brand/delivery-ifood.png')} alt="" width="28" height="28" loading="lazy" decoding="async"/><span>Pedir no iFood</span></a><a class="text-link menu-delivery-link" href={content.delivery.rappi_url} target="_blank" rel="noopener noreferrer" aria-label="Pedir no Rappi (abre em nova aba)"><img src={href('/brand/delivery-rappi.png')} alt="" width="28" height="28" loading="lazy" decoding="async"/><span>Pedir no Rappi</span></a></div></div></div></section>
</SiteLayout>
