---
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { getPostBySlug } from '../../lib/blogStore.js';
import { withBase } from '../../lib/paths.js';

const { slug } = Astro.params;
const post = await getPostBySlug(slug);
if (!post) return Astro.redirect(withBase('/blog/'), 302);
const body = post?.body?.replaceAll('src="/', `src="${withBase('/')}`) ?? '';
---
<Base title={`${post.title} — Casa Beliê`} description={post.excerpt} overHero>
  <article>
    <div class="hero-page hero-int article-hero">
      <picture class="hero-photo">
        <source media="(max-width:700px)" type="image/avif" srcset={withBase('/images/hero-blog-hq-mobile-768.avif')} />
        <source media="(max-width:700px)" srcset={withBase('/images/hero-blog-hq-mobile-768.webp')} />
        <source type="image/avif" srcset={`${withBase('/images/hero-blog-hq-1600.avif')} 1600w, ${withBase('/images/hero-blog-hq-2400.avif')} 2400w`} sizes="100vw" />
        <img src={withBase('/images/hero-blog-hq-2400.webp')} srcset={`${withBase('/images/hero-blog-hq-1600.webp')} 1600w, ${withBase('/images/hero-blog-hq-2400.webp')} 2400w`} sizes="100vw" alt="Campinho da Casa Beliê com uma bola pronta para brincar" width="2400" height="1350" loading="eager" fetchpriority="high" decoding="sync" />
      </picture>
      <span class="hero-shade" aria-hidden="true"></span>
      <div class="shell inner">
        <p class="hand data">{post.dateLabel}</p>
        <h1>{post.title}</h1>
      </div>
    </div>
    <section>
      <div class="shell corpo">
        {post.cover && <img class="capa" src={withBase(post.cover)} alt="" width="1200" height="675" loading="lazy" />}
        <div class="prosa" set:html={body} />
        <p class="volta"><a href={withBase('/blog/')}>← Todas as novidades</a></p>
      </div>
    </section>
  </article>
  <CtaFinal />
</Base>

<style>
  .article-hero{background:#2D2731}
  .hero-photo,.hero-shade{position:absolute;inset:0}
  .hero-photo{z-index:-2;width:100%;height:100%}
  .hero-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 60%}
  .hero-shade{z-index:-1;background:linear-gradient(90deg,rgba(31,25,35,.78),rgba(31,25,35,.43) 65%,rgba(31,25,35,.25))}
  .inner{position:relative;width:100%;padding-top:140px;padding-bottom:clamp(40px,7vh,72px);color:#fff}
  .data{color:var(--manteiga);font-size:1.4rem;margin-bottom:8px;text-shadow:0 1px 12px rgba(20,16,24,.4)}
  h1{font-size:clamp(2rem,4.6vw,3.3rem);max-width:22ch;text-shadow:0 2px 24px rgba(20,16,24,.42)}
  .corpo{max-width:760px}
  .capa{border-radius:18px;margin-bottom:32px;height:auto}
  .prosa :global(p){margin-bottom:20px;font-size:1.1rem}
  .prosa :global(em){font-style:italic}
  .prosa :global(img){border-radius:14px;margin:24px 0}
  .prosa :global(h2),.prosa :global(h3){margin:32px 0 12px}
  .volta{margin-top:40px}
  .volta a{color:var(--lav-prof);font-weight:800;text-decoration:none}
  .volta a:hover{text-decoration:underline}
</style>
