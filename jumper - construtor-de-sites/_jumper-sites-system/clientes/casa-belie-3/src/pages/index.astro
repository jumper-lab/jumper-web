---
import Base from '../layouts/Base.astro';
import Star from '../components/Star.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { getPublishedPosts } from '../lib/blogStore.js';
import { withBase } from '../lib/paths.js';

const posts = (await getPublishedPosts()).slice(0, 3);

const ambientes = [
  { nome: 'Quintal verde', desc: 'Espaço para correr, brincar e ter contato com a natureza em plena cidade.', nota: 'descalços, sempre' },
  { nome: 'Brinquedão', desc: 'Escorrega, piscina de bolinhas e desafios para os pequenos aventureiros.', nota: null },
  { nome: 'Muro de pintura', desc: 'Um muro inteiro para pintar de verdade, com tinta e pincel.', nota: 'pode sujar!' },
  { nome: 'Vila Beliê', desc: 'Casinha, bombeiros e mercadinho para inventar histórias e brincar de faz de conta.', nota: null },
  { nome: 'Sala de jogos', desc: 'Pingue-pongue, totó, air game, sinuca e jogos de tabuleiro para brincar junto.', nota: null },
  { nome: 'Espaço Baby', desc: 'Um cantinho seguro e acolhedor para as brincadeiras mais tranquilas.', nota: null },
];

const festas = [
  { num: '01', nome: 'Escolar', desc: '3 horas de festa após o horário escolar, com buffet e programação mais enxutos. A partir de 7 anos.' },
  { num: '02', nome: 'Infantil', desc: '4 horas de festa completa, com buffet, muitas atividades e decoração elaborada para cada história.' },
  { num: '03', nome: 'Teen', desc: '4 horas com buffet, sala de jogos, baladinha, música e uma decoração mais moderna e descolada.' },
  { num: '04', nome: 'Adulto & confraternizações', desc: 'Encontros acolhedores com buffet, decoração sofisticada, música e o jardim para brindar ao fim da tarde.' },
];

const avaliacoes = [
  { nome: 'Anne Jacobson', texto: '“Tudo, desde o primeiro contato até a conclusão da festa, foi perfeito.”' },
  { nome: 'Mario Tércio', texto: '“Espaço bem amplo e arejado, com uma equipe alegre, atenciosa e simpática.”' },
  { nome: 'Famílias no Google', texto: '“Ambiente acolhedor, comida gostosa, funcionários simpáticos e profissionais.”' },
];
---
<Base overHero={true}>
  <!-- HERO -->
  <div class="hero-page hero-home">
    <div class="bg" aria-hidden="true">
      <picture>
        <source type="image/avif" srcset={`${withBase('/images/r-hero-678.avif')} 678w, ${withBase('/images/r-hero-900.avif')} 900w, ${withBase('/images/r-hero-1205.avif')} 1205w`} sizes="100vw" />
        <img src={withBase('/images/r-hero-1600.webp')} srcset={`${withBase('/images/r-hero-900.webp')} 678w, ${withBase('/images/r-hero-900w.webp')} 900w, ${withBase('/images/r-hero-1600.webp')} 1205w`} sizes="100vw" width="1205" height="1600" alt="" fetchpriority="high" decoding="sync" />
      </picture>
      <video class="hero-video" data-src={withBase('/videos/festa-sophia.mp4')} muted loop playsinline preload="none"></video>
    </div>
    <div class="shell hero-inner">
      <span class="kicker"><Star color="#B9A5D8" size={18} /> Casa de festas · Laranjeiras, RJ</span>
      <h1>
        <span class="line"><span>Um belo lugar para</span></span>
        <span class="line"><span><span class="u-giz">celebrar o que importa<svg viewBox="0 0 320 24" preserveAspectRatio="none" aria-hidden="true"><path d="M6 15 C 50 8, 95 19, 150 12 S 250 9, 314 14" /></svg></span>.</span></span>
      </h1>
      <p>Na Casa Beliê, cada encontro é único. Uma casa de 800 m² com quintal verde, luz natural e uma estrutura completa para receber com leveza, charme e aconchego.</p>
      <div class="actions">
        <a class="btn" href="https://wa.me/5521996694990?text=Ol%C3%A1!%20Quero%20saber%20mais%20sobre%20festas%20na%20Casa%20Beli%C3%AA%20:)" target="_blank" rel="noopener" data-evt="whatsapp">
          Pedir orçamento <span class="arr">→</span>
          <svg class="scribble" viewBox="0 0 240 74" preserveAspectRatio="none" aria-hidden="true"><path d="M18 37 C 14 12, 80 6, 122 8 C 180 10, 232 16, 228 38 C 224 62, 160 68, 110 66 C 60 64, 20 58, 22 40" /></svg>
        </a>
        <a class="btn ghost" href={withBase('/espaco/')}>Conhecer a casa</a>
      </div>
      <p class="confia">Espaço, buffet, decoração, lazer infantil, recreação e equipe <span aria-hidden="true">✳</span> 5,0 no Google</p>
    </div>
    <div class="nota" aria-hidden="true">
      <span class="hand">cada detalhe à mão ♡</span>
    </div>
  </div>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="track">
      <span>quintal verde <i class="st">✳</i> luz natural <i class="st">✳</i> sem telas <i class="st">✳</i> brincar livre <i class="st">✳</i> decoração afetiva <i class="st">✳</i> festa completa <i class="st">✳</i></span>
      <span>quintal verde <i class="st">✳</i> luz natural <i class="st">✳</i> sem telas <i class="st">✳</i> brincar livre <i class="st">✳</i> decoração afetiva <i class="st">✳</i> festa completa <i class="st">✳</i></span>
    </div>
  </div>

  <!-- MANIFESTO -->
  <section class="manifesto">
    <div class="shell grid2">
      <figure class="reveal">
        <blockquote>“Tudo aqui foi pensado para receber com leveza, charme e aquele aconchego de quem abre a porta da própria casa para quem ama.”</blockquote>
        <figcaption>— Isabela & Cecília, fundadoras · Madame Girafa e Vila Pindorama</figcaption>
      </figure>
      <div class="polaroid rot2 reveal" style="transition-delay:.15s">
        <span class="tape" aria-hidden="true"></span>
        <picture>
          <source type="image/avif" srcset={`${withBase('/images/r-socias-640.avif')} 640w, ${withBase('/images/r-socias-720.avif')} 720w, ${withBase('/images/r-socias-1080.avif')} 1080w`} sizes="(max-width:880px) 92vw, 40vw" />
          <img src={withBase('/images/r-socias-720.webp')} srcset={`${withBase('/images/r-socias-640.webp')} 640w, ${withBase('/images/r-socias-720.webp')} 720w, ${withBase('/images/r-socias-1080.webp')} 1080w`} sizes="(max-width:880px) 92vw, 40vw" width="1080" height="520" alt="Isabela e Cecília, fundadoras da Casa Beliê, abraçadas e sorrindo" loading="lazy" decoding="async" />
        </picture>
        <span class="cap">Isabela &amp; Cecília ♡</span>
      </div>
    </div>
  </section>

  <!-- A CASA / AMBIENTES -->
  <section>
    <div class="shell">
      <span class="kicker k-verde reveal"><Star color="#3D5A34" /> A casa</span>
      <h2 class="reveal">800 m² de casa, quintal e imaginação.</h2>
      <p class="lead reveal">Uma casa de dois andares com ambientes lúdicos, aconchegantes e climatizados — e um quintal verde onde as principais brincadeiras acontecem.</p>
      <div class="ambientes">
        {ambientes.map((a, i) => (
          <div class="amb reveal" style={`transition-delay:${i * 0.07}s`}>
            <h3>{a.nome}</h3>
            <p>{a.desc}</p>
            {a.nota && <span class="nota-hand" aria-hidden="true">{a.nota}</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FESTAS -->
  <section class="festas">
    <div class="shell">
      <span class="kicker k-verde reveal"><Star color="#3D5A34" /> Festas & experiências</span>
      <h2 class="reveal">Quatro jeitos de fazer a casa celebrar.</h2>
      <div class="lista">
        {festas.map((f, i) => (
          <a class="row reveal" href={withBase('/festas/')} style={`transition-delay:${i * 0.08}s`}>
            <span class="num" style={`--tilt:${[-3, 2, -1, 3][i]}deg`}>
              {f.num}
              <svg viewBox="0 0 90 60" class="num-circle stroke" aria-hidden="true">
                <path d="M12 30 C 10 12, 40 6, 55 8 C 76 10, 84 22, 82 34 C 80 50, 52 56, 34 52 C 18 49, 10 40, 13 31" stroke="#B9A5D8" stroke-width="2.5" />
              </svg>
            </span>
            <span><h3>{f.nome}</h3><p>{f.desc}</p></span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="mais reveal"><a href={withBase('/festas/')}>Ver todas as festas e experiências →</a></p>
    </div>
  </section>

  <!-- MURO DE MEMÓRIAS -->
  <section class="muro">
    <div class="shell">
      <span class="kicker reveal" style="color:var(--manteiga)"><Star color="#F7E8C9" /> O muro de memórias</span>
      <h2 class="reveal">Cada festa deixa uma marca na casa.</h2>
      <p class="lead reveal">Como o nosso muro de pintura: cada festa deixa uma marca aqui. Momentos reais das nossas festas, direto do <a href="https://www.instagram.com/casabelie/" target="_blank" rel="noopener">@casabelie</a>.</p>
      <div class="fotos">
        <div class="polaroid g1 reveal"><span class="tape" aria-hidden="true"></span><img src={withBase('/images/r-baby-1000.webp')} srcset={`${withBase('/images/r-baby-600.webp')} 338w, ${withBase('/images/r-baby-1000.webp')} 563w`} sizes="(max-width:780px) 92vw, 30vw" width="563" height="1000" alt="Pai brincando de jogar a filha para o alto numa festa cheia de balões e flores na Casa Beliê" loading="lazy" decoding="async" style="aspect-ratio:3/4" /><span class="cap">alegria de verdade</span></div>
        <div class="polaroid g2 reveal" style="transition-delay:.1s"><span class="tape" aria-hidden="true"></span><img src={withBase('/images/r-mesa-1000.webp')} srcset={`${withBase('/images/r-mesa-600.webp')} 338w, ${withBase('/images/r-mesa-1000.webp')} 563w`} sizes="(max-width:780px) 92vw, 30vw" width="563" height="1000" alt="Sócia da Casa Beliê finalizando a mesa de bolo de uma festa de 1 aninho com tema circo" loading="lazy" decoding="async" style="aspect-ratio:3/4" /><span class="cap">cada detalhe da mesa ♡</span></div>
        <div class="polaroid g3 reveal" style="transition-delay:.2s"><span class="tape" aria-hidden="true"></span><img src={withBase('/images/r-bolo-1000.webp')} srcset={`${withBase('/images/r-bolo-600.webp')} 600w, ${withBase('/images/r-bolo-1000.webp')} 1000w`} sizes="(max-width:780px) 92vw, 30vw" width="1000" height="907" alt="Calda de chocolate servida sobre bolo caseiro no prato 'fica, vai ter bolo' da Casa Beliê" loading="lazy" style="aspect-ratio:3/4" /><span class="cap">fica, vai ter bolo</span></div>
      </div>
      <span class="nota-hand assin reveal" aria-hidden="true">← cada festa deixa uma marca</span>
    </div>
  </section>

  <!-- FUNDADORAS -->
  <section class="fundadoras">
    <div class="shell">
      <span class="kicker k-lav reveal"><Star /> Quem abre a porta</span>
      <h2 class="reveal">Duas mães de casas que já fizeram muita festa.</h2>
      <div class="duo">
        <figure class="retrato-duo reveal">
          <div class="polaroid" style="transform:rotate(-1.6deg)">
            <span class="tape" aria-hidden="true"></span>
            <picture>
              <source type="image/avif" srcset={`${withBase('/images/r-socias-640.avif')} 640w, ${withBase('/images/r-socias-720.avif')} 720w, ${withBase('/images/r-socias-1080.avif')} 1080w`} sizes="(max-width:760px) 92vw, 46vw" />
              <img src={withBase('/images/r-socias-720.webp')} srcset={`${withBase('/images/r-socias-640.webp')} 640w, ${withBase('/images/r-socias-720.webp')} 720w, ${withBase('/images/r-socias-1080.webp')} 1080w`} sizes="(max-width:760px) 92vw, 46vw" width="1080" height="520" alt="Isabela e Cecília, sócias da Casa Beliê, abraçadas e sorrindo" loading="lazy" decoding="async" />
            </picture>
            <span class="cap">Isabela &amp; Cecília ♡</span>
          </div>
        </figure>
        <div class="bios reveal" style="transition-delay:.1s">
          <article class="pessoa">
            <h3>Isabela</h3>
            <p>Fundadora da Madame Girafa, referência em festas afetivas e personalizadas no Rio de Janeiro desde 2014.</p>
          </article>
          <article class="pessoa">
            <h3>Cecília</h3>
            <p>Sócia da Vila Pindorama, casa de festas em Icaraí reconhecida pela proposta lúdica e acolhedora.</p>
          </article>
          <p class="nota-hand" aria-hidden="true">a gente cuida como se fosse da nossa família</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NÚMEROS -->
  <section class="numeros">
    <div class="shell trio">
      <div class="reveal"><span class="serif n">800 m²</span><p>de casa e quintal</p></div>
      <div class="reveal" style="transition-delay:.1s"><span class="serif n">0</span><p>telas na festa</p></div>
      <div class="reveal" style="transition-delay:.2s"><span class="serif n">2</span><p>fundadoras com anos de festa na bagagem</p></div>
    </div>
  </section>

  <!-- AVALIAÇÕES DO GOOGLE -->
  <section class="avaliacoes">
    <div class="shell">
      <div class="avaliacoes-head reveal">
        <div>
          <span class="kicker k-lav"><Star /> Avaliações do Google</span>
          <h2>Quem já celebrou conta melhor.</h2>
        </div>
        <a class="nota-google" href="https://www.google.com/maps/place/Casa+Beli%C3%AA/" target="_blank" rel="noopener" aria-label="Ver avaliações da Casa Beliê no Google">
          <strong>5,0</strong><span aria-hidden="true">★★★★★</span><small>1.487 avaliações · consultado em 10/09/2026</small>
        </a>
      </div>
      <div class="cards-avaliacao">
        {avaliacoes.map((avaliacao, i) => (
          <article class="card-avaliacao reveal" style={`transition-delay:${i * 0.08}s`}>
            <span class="estrelas" role="img" aria-label="5 estrelas">★★★★★</span>
            <p>{avaliacao.texto}</p>
            <strong>{avaliacao.nome}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- NOVIDADES -->
  <section class="novidades">
    <div class="shell">
      <span class="kicker k-verde reveal"><Star color="#3D5A34" /> Novidades</span>
      <h2 class="reveal">O que anda acontecendo na casa.</h2>
      {posts.length > 0 ? (
        <div class="posts">
          {posts.map((p, i) => (
            <a class="post reveal" href={withBase(`/blog/${p.slug}/`)} style={`transition-delay:${i * 0.08}s`}>
              <span class="data hand">{p.dateLabel}</span>
              <h3>{p.title}</h3>
              <p>{p.excerpt}</p>
              <span class="ler">Ler novidade →</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="lead reveal">As primeiras novidades estão no forno. <span class="nota-hand">volta logo :)</span></p>
      )}
    </div>
  </section>

  <CtaFinal />
</Base>

<style>
  /* HERO — composição centralizada */
  .hero-home{align-items:center}
  .hero-page .bg{position:absolute;inset:0;z-index:-1}
  .hero-page .bg picture{display:contents}
  .hero-page .bg img{width:100%;height:100%;object-fit:cover;animation:hero-scale 1.5s var(--ease) both}
  @media(max-width:700px){.hero-page .bg img{animation:none}}
  .hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 30%;opacity:0;transition:opacity .7s var(--ease)}
  .hero-video.ready{opacity:1}
  @media (prefers-reduced-motion: reduce){.hero-video{display:none}}
  .hero-page .bg::after{content:"";position:absolute;inset:0;background:
    linear-gradient(to bottom, rgba(45,36,55,.40) 0%, rgba(45,36,55,.10) 16%, rgba(45,36,55,0) 30%),
    linear-gradient(to top, rgba(45,36,55,.52) 0%, rgba(45,36,55,.20) 46%, rgba(45,36,55,.04) 78%, rgba(45,36,55,0) 100%)}
  .hero-inner{width:100%;padding-top:110px;padding-bottom:clamp(40px,7vh,80px);color:#fff;
    display:flex;flex-direction:column;align-items:center;text-align:center}
  .hero-inner>.kicker,.hero-inner h1,.hero-inner>p,.hero-inner .actions{animation:hero-rise .82s var(--ease) both}
  .hero-inner h1{animation-delay:.08s}
  .hero-inner>p{animation-delay:.16s}
  .hero-inner .actions{animation-delay:.24s}
  .hero-inner .confia{animation-delay:.32s}
  .hero-inner .u-giz path{stroke-dashoffset:640;animation:hero-draw .9s var(--ease) .62s both}
  .hero-inner h1{font-family:"Fraunces Hero","Fraunces",Georgia,serif;font-size:clamp(2.6rem,6.6vw,5rem);margin:16px auto 16px;font-weight:370;letter-spacing:.01em;text-shadow:0 2px 24px rgba(45,36,55,.4)}
  @media(max-width:560px){
    .hero-inner{padding-top:96px;padding-bottom:32px}
    .hero-inner h1{font-size:clamp(1.65rem,8.3vw,3.1rem);max-width:100%}
    .hero-inner p{font-size:1rem;margin-bottom:20px}
    .actions{gap:10px}
    .confia{margin-top:18px!important;line-height:1.45}
  }
  .hero-inner h1 .line{display:block;overflow:hidden;padding:0 .12em .24em;margin-bottom:-.24em}
  .hero-inner h1 .line>span{display:inline-block}
  .hero-inner p{max-width:54ch;font-size:1.1rem;color:rgba(255,255,255,.93);margin:0 auto 28px;text-shadow:0 1px 12px rgba(45,36,55,.35)}
  .actions{display:flex;gap:16px;flex-wrap:wrap;justify-content:center}
  @media(max-width:480px){.actions{width:100%}.actions .btn{width:100%;justify-content:center}}
  .confia{font-size:.88rem!important;max-width:none!important;color:rgba(255,255,255,.82)!important;margin-top:26px!important}
  .confia span{color:var(--lav-brand);margin:0 8px}
  .confia a{color:#fff;font-weight:800;text-decoration:none;border-bottom:1.5px solid var(--lav-brand)}
  .confia a:hover{border-bottom-color:#fff}
  .nota{position:absolute;right:clamp(24px,6vw,90px);bottom:30vh;color:#fff;display:none;flex-direction:column;gap:2px}
  @media(min-width:1000px){.nota{display:flex}}
  .nota .hand{font-size:1.5rem;transform:rotate(-4deg)}
  .nota{animation:hero-rise .9s var(--ease) .42s both}
  @media(prefers-reduced-motion:reduce){.hero-page .bg img,.hero-inner>.kicker,.hero-inner h1,.hero-inner>p,.hero-inner .actions,.nota{animation:none}.hero-inner .u-giz path{animation:none;stroke-dashoffset:0}}

  /* MANIFESTO */
  .manifesto{background:var(--areia)}
  .grid2{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(32px,5vw,80px);align-items:center}
  @media(max-width:880px){.grid2{grid-template-columns:1fr}}
  blockquote{font-family:Caveat,cursive;font-weight:500;font-size:clamp(1.7rem,3vw,2.3rem);line-height:1.3;transform:rotate(-.6deg)}
  figcaption{margin-top:18px;font-size:.9rem;color:var(--ink-suave)}
  .rot2{transform:rotate(2.2deg);max-width:440px}
  .polaroid img{height:auto}

  /* AMBIENTES */
  .ambientes{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,40px);margin-top:44px}
  @media(max-width:900px){.ambientes{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.ambientes{grid-template-columns:1fr}}
  .amb{border-top:2px solid var(--areia);padding-top:20px;position:relative}
  .amb h3{font-size:1.25rem;margin-bottom:8px}
  .amb p{color:var(--ink-suave);font-size:.96rem}
  .amb .nota-hand{color:var(--verde);font-size:1.3rem;transform:rotate(-2deg);margin-top:8px}

  /* FESTAS */
  .festas{background:var(--papel)}
  .lista{margin-top:30px}
  .row{display:grid;grid-template-columns:76px 1fr auto;gap:clamp(16px,3vw,40px);align-items:center;
    padding:28px 12px;border-bottom:1px solid rgba(58,52,64,.12);text-decoration:none;
    transition:background .35s var(--ease),padding-left .35s var(--ease)}
  .row:is(:hover,:focus-visible){background:var(--brisa);padding-left:24px;border-radius:16px}
  .row:focus-visible{outline:2px solid var(--lav-prof);outline-offset:3px}
  .num{position:relative;font-family:"Fraunces",serif;font-size:1.6rem;color:var(--mata);text-align:center}
  .num svg{position:absolute;inset:-10px -8px;width:calc(100% + 16px);height:calc(100% + 20px);pointer-events:none;transform:rotate(var(--tilt,0deg))}
  .num-circle path{stroke-dasharray:230;stroke-dashoffset:230;transition:stroke-dashoffset .58s var(--ease)}
  .row:is(:hover,:focus-visible) .num-circle path{stroke-dashoffset:0}
  .row h3{font-size:1.35rem;margin-bottom:3px}
  .row p{color:var(--ink-suave);font-size:.96rem;max-width:56ch}
  .go{width:46px;height:46px;border-radius:50%;border:1.5px solid var(--verde);display:grid;place-items:center;color:var(--mata);
    transition:background .3s,color .3s,transform .3s var(--ease)}
  .row:is(:hover,:focus-visible) .go{background:var(--verde);color:#fff;transform:translateX(4px) rotate(-8deg)}
  @media(max-width:640px){.row{grid-template-columns:1fr auto}.num{display:none}}
  @media(prefers-reduced-motion:reduce){.num-circle path{transition:none}}
  .mais{margin-top:24px}
  .mais a{color:var(--lav-prof);font-weight:800;text-decoration:none}
  .mais a:hover{text-decoration:underline}

  /* MURO */
  .muro{background:var(--mata);color:var(--papel)}
  .muro h2{color:var(--papel)}
  .muro .lead{color:rgba(253,250,244,.78)}
  .muro .lead a{color:var(--manteiga);font-weight:800;text-decoration:none;border-bottom:1.5px solid rgba(247,232,201,.5)}
  .muro .lead a:hover{border-bottom-color:var(--manteiga)}
  .fotos{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,40px);margin-top:48px}
  @media(max-width:780px){.fotos{grid-template-columns:1fr;max-width:430px}}
