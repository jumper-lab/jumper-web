<script>
  const heroVideo = document.querySelector('.hero-video');
  if (heroVideo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const startVideo = () => {
      if (innerWidth < 720 || navigator.connection?.saveData) return;
      if (!heroVideo.src) heroVideo.src = heroVideo.dataset.src ?? '';
      heroVideo.play().catch(() => {});
    };
    const opts = { once: true, passive: true };
    addEventListener('pointerdown', startVideo, opts);
    addEventListener('pointermove', startVideo, opts);
    addEventListener('touchstart', startVideo, opts);
    addEventListener('keydown', startVideo, { once: true });
    heroVideo.addEventListener('playing', () => heroVideo.classList.add('ready'), { once: true });
  }
</script>
