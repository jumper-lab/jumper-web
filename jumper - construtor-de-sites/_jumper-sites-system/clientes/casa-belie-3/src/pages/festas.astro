---
import Base from '../layouts/Base.astro';
import HeroInterno from '../components/HeroInterno.astro';
import Star from '../components/Star.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { withBase } from '../lib/paths.js';

const formatos = [
  {
    num: '01', nome: 'Escolar', duracao: '3 horas', faixa: 'A partir de 7 anos', cor: 'var(--brisa)',
    desc: 'Uma comemoração depois da escola, com praticidade para as famílias e muita diversão para as crianças. Buffet, decoração e programação mais enxutos, sem abrir mão das brincadeiras e da alegria.',
  },
  {
    num: '02', nome: 'Infantil', duracao: '4 horas', faixa: 'Formato completo', cor: 'var(--lav-veu)',
    desc: 'Buffet completo, muitas atividades e uma decoração mais elaborada. Tudo pensado para receber os convidados com conforto e transformar cada detalhe da celebração.',
  },
  {
    num: '03', nome: 'Teen', duracao: '4 horas', faixa: 'Com a cara deles', cor: 'var(--pessego)',
    desc: 'Sala de jogos, jogos de tabuleiro, baladinha, música e dança. A decoração ganha uma proposta moderna e descolada para comemorar, tirar fotos e curtir com os amigos.',
  },
  {
    num: '04', nome: 'Adulto & confraternizações', duracao: 'Sob medida', faixa: 'Também para mini celebrações', cor: 'var(--manteiga)',
    desc: 'Um ambiente acolhedor e elegante, com decoração sofisticada, buffet completo e música ambiente. DJ, pista de dança e diversão infantil podem ser incluídos como opcionais.',
  },
];

const buffet = [
  {
    nome: 'Entradinhas',
    itens: ['Batatinha assada com ervas', 'Caldinho de feijão', 'Guacamole com nachos', 'Dadinho de tapioca com geleia de pimenta', 'Bruschetta de tomate', 'Pastinha de grão-de-bico com torradinhas', 'Barquinha de caponata de berinjela', 'Palitinho caprese'],
  },
  { nome: 'Refeições', itens: ['Duas opções: uma massa e uma proteína'] },
  { nome: 'Salgados', itens: ['Variedade de salgados assados e fritos'] },
  { nome: 'Buffet Baby', itens: ['Frutinhas', 'Biscoito de polvilho', 'Danoninho caseiro', 'Bolo de banana sem açúcar'] },
  { nome: 'Buffet Infantil', itens: ['Batata frita', 'Cachorro-quente', 'Mini pizza', 'Mini hambúrguer', 'Milho cozido', 'Mini joelho', 'Pipoca'] },
];

const lazer = ['Brinquedão', 'Parede de escalada', 'Vila Beliê', 'Oficina de criação', 'Parede montessoriana', 'Área molhada', 'Muro de pintura', 'Fantasias', 'Quintal verde', 'Sala de jogos', 'Casa no alto', 'Espaço Baby', 'Futebol', 'Carrinhos e bonecos'];

const passos = [
  { passo: '1', titulo: 'Você conta o encontro', desc: 'Data, tipo de evento, tamanho da turma e o que imagina para esse dia.' },
  { passo: '2', titulo: 'A gente organiza tudo', desc: 'Formato, cardápio, decoração, recreação e opcionais são combinados com você.' },
  { passo: '3', titulo: 'Só viver', desc: 'No dia, a equipe cuida da casa e da festa para você aproveitar cada momento.' },
];
---
<Base title="Festas na Casa Beliê — infantil, escolar, teen e adulto" description="Conheça os formatos de festa da Casa Beliê: eventos escolares, infantis, teens, adultos e confraternizações com buffet, decoração, recreação e equipe." overHero>
  <HeroInterno kicker="Festas & encontros" headline="Cada celebração encontra o seu jeito aqui." strokeWord="seu jeito" sub="Quatro formatos, uma casa inteira e uma equipe que cuida de tudo para você viver o momento." surface="var(--brisa)" starColor="#3D5A34" image="/images/hero-festas-hq-2400.webp" imageMedium="/images/hero-festas-hq-1600.webp" imageSmall="/images/hero-festas-hq-mobile-768.webp" imageAvif="/images/hero-festas-hq-2400.avif" imageMediumAvif="/images/hero-festas-hq-1600.avif" imageSmallAvif="/images/hero-festas-hq-mobile-768.avif" imageAlt="Família celebrando uma festa na Casa Beliê" imagePosition="68% 50%" imageWidth={2400} imageHeight={1350} />

  <section id="formatos">
    <div class="shell">
      <span class="kicker k-verde reveal"><Star color="#3D5A34" /> Escolha o formato</span>
      <h2 class="reveal">Da saída da escola ao brinde no jardim.</h2>
      <p class="lead reveal">A Casa Beliê recebe diferentes idades e ocasiões. Em todos os formatos, a proposta é a mesma: acolhimento, boa comida e tempo de qualidade junto.</p>
      <div class="formatos">
        {formatos.map((formato, i) => (
          <article class="formato reveal" style={`--card:${formato.cor};transition-delay:${i * 0.07}s`}>
            <div class="formato-top"><span class="num serif">{formato.num}</span><span class="duracao">{formato.duracao}</span></div>
            <h3>{formato.nome}</h3>
            <p>{formato.desc}</p>
            <span class="faixa">{formato.faixa}</span>
          </article>
        ))}
      </div>
      <p class="nota-formato nota-hand reveal" aria-hidden="true">no fim da tarde, o jardim pede um brinde ♡</p>
    </div>
  </section>

  <section class="inclui">
    <div class="shell inclui-grid">
      <div class="reveal">
        <span class="kicker" style="color:var(--manteiga)"><Star color="#F7E8C9" /> Festa completa</span>
        <h2>A casa cuida do todo.</h2>
        <p class="lead">Espaço, buffet, decoração, lazer infantil, recreação e equipe trabalham juntos para que a experiência seja leve do primeiro contato ao último convidado.</p>
      </div>
      <figure class="reveal" style="transition-delay:.1s">
        <img src={withBase('/images/r-mesa-1000.webp')} srcset={`${withBase('/images/r-mesa-600.webp')} 338w, ${withBase('/images/r-mesa-1000.webp')} 563w`} sizes="(max-width:860px) 92vw, 42vw" width="563" height="1000" alt="Mesa de bolo de uma festa infantil montada pela Casa Beliê" loading="lazy" decoding="async" />
        <figcaption class="nota-hand">cada detalhe entra na história</figcaption>
      </figure>
    </div>
  </section>

  <section id="buffet" class="buffet">
    <div class="shell">
      <div class="buffet-head">
        <div>
          <span class="kicker k-terra reveal"><Star color="#D98E6A" /> Buffet Beliê</span>
          <h2 class="reveal">Opções gostosas para todas as idades.</h2>
        </div>
        <p class="lead reveal">Um cardápio equilibrado para adultos, crianças e bebês, com variedade do começo da festa até a refeição.</p>
      </div>
      <div class="buffet-grid">
        {buffet.map((grupo, i) => (
          <article class={`buffet-card b${i + 1} reveal`} style={`transition-delay:${i * 0.06}s`}>
            <div class="buffet-card-head">
              <h3>{grupo.nome}</h3>
              <span class="buffet-index serif" aria-hidden="true">0{i + 1}</span>
            </div>
            <ul role="list">{grupo.itens.map(item => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="observacao reveal">* Os pacotes escolares possuem opções simplificadas de buffet.</p>
    </div>
  </section>

  <section id="recreacao" class="recreacao">
    <div class="shell recreacao-grid">
      <div class="reveal">
        <span class="kicker" style="color:var(--manteiga)"><Star color="#F7E8C9" /> Recreação</span>
        <h2>Brincar livre é coisa séria por aqui.</h2>
        <p class="lead">A recreação é lúdica e respeitosa, conduzida por uma equipe acolhedora e acompanhada por monitores nos diferentes espaços da casa.</p>
        <p class="lead">Sem telas: a diversão acontece com movimento, criatividade, natureza e brincadeiras que atravessam gerações.</p>
        <a class="btn ghost" href={withBase('/espaco/')}>Conhecer cada espaço <span class="arr">→</span></a>
      </div>
      <ul class="lazer-lista reveal" role="list" style="transition-delay:.1s">
        {lazer.map(item => <li><Star color="#B9A5D8" size={13} /> {item}</li>)}
      </ul>
    </div>
  </section>

  <section id="decoracao" class="decoracao">
    <div class="shell decoracao-grid">
      <figure class="polaroid reveal" style="transform:rotate(-1.4deg)">
        <span class="tape" aria-hidden="true"></span>
        <img src={withBase('/images/r-hero-1600.webp')} srcset={`${withBase('/images/r-hero-900.webp')} 678w, ${withBase('/images/r-hero-1600.webp')} 1205w`} sizes="(max-width:860px) 92vw, 44vw" width="1205" height="1600" alt="Decoração temática com bolo, doces, flores e balões na Casa Beliê" loading="lazy" decoding="async" />
        <span class="cap">afetiva, minimalista e feita aqui ♡</span>
      </figure>
      <div class="reveal" style="transition-delay:.1s">
        <span class="kicker k-lav"><Star /> Decoração inclusa</span>
        <h2>Você escolhe o tema. O resto é por nossa conta.</h2>
        <p class="lead">A linguagem de decoração da casa foi criada por Isabela, da Madame Girafa, com 13 anos de atuação no mercado. Afetiva e minimalista, ela é executada pela própria equipe da Casa Beliê.</p>
        <p class="lead">Nas festas temáticas, os itens essenciais para criar uma decoração especial já estão incluídos.</p>
      </div>
    </div>
  </section>

  <section class="como">
    <div class="shell">
      <span class="kicker k-lav reveal"><Star /> Como funciona</span>
      <h2 class="reveal">Três passos até a celebração.</h2>
      <div class="passos">
        {passos.map((passo, i) => (
          <article class="passo reveal" style={`transition-delay:${i * 0.1}s`}>
            <span class="serif n">{passo.passo}</span>
            <h3>{passo.titulo}</h3>
            <p>{passo.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaFinal headline="Qual celebração você imagina?" sub="Conte a data e o tipo de evento. A gente apresenta o formato e o orçamento ideais para você." />
</Base>

<style>
  .formatos{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:42px}
  .formato{background:var(--card);border-radius:22px;padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;min-height:310px;border:1px solid rgba(58,52,64,.06)}
  .formato-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}
  .num{font-size:1.5rem;color:var(--lav-prof)}
  .duracao{font-size:.76rem;font-weight:800;text-transform:uppercase;letter-spacing:.12em;background:rgba(255,255,255,.65);border-radius:999px;padding:7px 11px}
  .formato h3{font-size:1.6rem;margin-bottom:12px}
  .formato p{color:var(--ink-suave);font-size:.97rem}
  .faixa{font-weight:800;color:var(--mata);font-size:.85rem;margin-top:auto;padding-top:24px}
  .nota-formato{color:var(--verde);transform:rotate(-2deg);margin-top:24px}
  @media(max-width:760px){.formatos{grid-template-columns:1fr}.formato{min-height:0}.faixa{margin-top:18px}}

  .inclui{background:var(--mata);color:var(--papel)}
  .inclui-grid,.recreacao-grid,.decoracao-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,6vw,82px);align-items:center}
  .inclui h2,.recreacao h2{color:var(--papel)}
  .inclui .lead,.recreacao .lead{color:rgba(253,250,244,.82)}
  .inclui figure{margin:0;position:relative}
  .inclui img{width:100%;height:clamp(360px,52vw,590px);object-fit:cover;border-radius:20px}
  .inclui figcaption{position:absolute;right:14px;bottom:-25px;color:var(--manteiga);transform:rotate(-3deg)}

  .buffet{position:relative;overflow:hidden;background:var(--papel)}
  .buffet::before{content:"";position:absolute;width:420px;height:420px;border-radius:50%;right:-210px;top:-190px;background:var(--lav-veu);opacity:.7;pointer-events:none}
  .buffet .shell{position:relative}
  .buffet-head{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.75fr);gap:clamp(32px,7vw,96px);align-items:end}
  .buffet-head h2{font-size:clamp(2.1rem,4.2vw,3.35rem);max-width:18ch;margin-bottom:0}
  .buffet-head .lead{padding-bottom:7px}
  .buffet-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:20px;margin-top:clamp(38px,6vw,64px)}
  .buffet-card{position:relative;min-height:190px;border:1px solid rgba(58,52,64,.07);border-radius:24px;padding:clamp(24px,3vw,34px);grid-column:span 4;overflow:hidden;transition:transform .35s var(--ease),box-shadow .35s var(--ease)}
  .buffet-card:hover{transform:translateY(-5px);box-shadow:0 22px 42px -28px rgba(58,52,64,.5)}
  .buffet-card.b1{grid-column:span 7;background:var(--lav-veu)}
  .buffet-card.b2{grid-column:span 5;background:var(--brisa)}
  .buffet-card.b3{background:#fff}
  .buffet-card.b4{background:var(--pessego)}
  .buffet-card.b5{background:var(--manteiga)}
  .buffet-card-head{display:flex;align-items:start;justify-content:space-between;gap:20px;margin-bottom:20px}
  .buffet-card h3{font-size:clamp(1.2rem,2vw,1.45rem);color:var(--lav-prof)}
  .buffet-index{color:rgba(106,84,151,.42);font-size:1.05rem;line-height:1}
  .buffet-card ul{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:9px}
  .buffet-card li{font-size:.86rem;background:rgba(255,255,255,.7);border:1px solid rgba(58,52,64,.055);padding:8px 12px;border-radius:999px;line-height:1.3}
  .observacao{font-size:.86rem;color:var(--ink-suave);margin-top:24px;padding-left:2px}
  @media(max-width:900px){
    .buffet-head{grid-template-columns:1fr;gap:18px;align-items:start}
    .buffet-grid{grid-template-columns:repeat(2,1fr)}
    .buffet-card,.buffet-card.b2,.buffet-card.b3,.buffet-card.b4,.buffet-card.b5{grid-column:auto}
    .buffet-card.b1{grid-column:1/-1}
  }
  @media(max-width:560px){
    .buffet-grid{grid-template-columns:1fr}
    .buffet-card,.buffet-card.b1{grid-column:auto;min-height:0}
    .buffet-card{padding:24px 20px}
    .buffet-card li{overflow-wrap:anywhere}
    .buffet::before{width:260px;height:260px;right:-150px;top:-110px}
  }

  .recreacao{background:var(--mata);color:var(--papel)}
  .recreacao .lead + .lead{margin-top:16px}
  .recreacao .btn{margin-top:26px}
  .lazer-lista{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:0;list-style:none}
  .lazer-lista li{display:flex;align-items:center;gap:9px;background:rgba(253,250,244,.08);border:1px solid rgba(253,250,244,.12);border-radius:12px;padding:12px 14px;font-size:.9rem}

  .decoracao{background:var(--lav-veu)}
  .decoracao-grid{grid-template-columns:minmax(0,.9fr) minmax(320px,1fr);gap:clamp(44px,7vw,96px)}
  .decoracao figure{width:100%;max-width:520px;margin:0;justify-self:start}
  .decoracao figure img{width:100%;height:clamp(360px,38vw,500px);aspect-ratio:auto;object-fit:cover;object-position:50% 55%}
  .decoracao-grid > div{max-width:540px}
  .decoracao .lead + .lead{margin-top:16px}

  .como{background:var(--brisa)}
  .passos{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,40px);margin-top:40px}
  .passo{background:#fff;border-radius:20px;padding:32px;border:1px solid rgba(58,52,64,.06)}
  .passo .n{display:block;font-size:2.2rem;color:var(--lav-prof);margin-bottom:10px}
  .passo h3{font-size:1.2rem;margin-bottom:8px}
  .passo p{color:var(--ink-suave);font-size:.95rem}
  @media(max-width:860px){
    .inclui-grid,.recreacao-grid,.decoracao-grid{grid-template-columns:1fr}
    .decoracao figure{max-width:560px;justify-self:center}
    .decoracao figure img{height:min(110vw,520px)}
    .decoracao-grid > div{max-width:620px}
  }
  @media(max-width:780px){.passos{grid-template-columns:1fr}}
  @media(max-width:520px){.lazer-lista{grid-template-columns:1fr}}
</style>
