---
import Base from '../layouts/Base.astro';
import HeroInterno from '../components/HeroInterno.astro';
import Star from '../components/Star.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { withBase } from '../lib/paths.js';

// Fotos reais do espaço da Casa Beliê, com versões leves para o mosaico e
// versões maiores carregadas somente quando o lightbox é aberto.
const fotos = [
  { slot: 'f1', src: 'espaco-fachada', smlW: 600, bigW: 1200, width: 1200, height: 1600, alt: 'Fachada completa da Casa Beliê com varanda, mesas e quintal', cap: 'a casa de portas abertas' },
  { slot: 'f2', src: 'espaco-corredor', smlW: 600, bigW: 1200, width: 1200, height: 1600, alt: 'Corredor coberto e iluminado da Casa Beliê com mesas e plantas', cap: 'luz natural por toda parte' },
  { slot: 'f3', src: 'espaco-quintal', smlW: 603, bigW: 739, width: 739, height: 980, alt: 'Quintal verde da Casa Beliê com brinquedos e piscina de bolinhas', cap: 'quintal para brincar livre' },
  { slot: 'f4', src: 'espaco-galeria', smlW: 800, bigW: 1600, width: 1600, height: 900, alt: 'Área de convivência coberta da Casa Beliê com mesas, plantas e Vila Beliê', cap: 'espaços para estar junto' },
  { slot: 'f5', src: 'espaco-campinho', smlW: 600, bigW: 1200, width: 1200, height: 1600, alt: 'Campinho de futebol da Casa Beliê com uma bola ao centro', cap: 'um campinho só deles' },
];

const ambientes = [
  { nome: 'Brinquedão', desc: 'Escorrega, piscina de bolinhas e desafios para os pequenos aventureiros.' },
  { nome: 'Parede de escalada', desc: 'Diversão vertical para quem gosta de um desafio.' },
  { nome: 'Vila Beliê', desc: 'Casinha, bombeiros, mercadinho e cenários para criar histórias.' },
  { nome: 'Oficina de criação', desc: 'Um espaço para experimentar, inventar e colocar a imaginação em prática.' },
  { nome: 'Parede montessoriana', desc: 'Atividades que estimulam autonomia, criatividade e desenvolvimento motor.' },
  { nome: 'Área molhada', desc: 'Chuveirão e diversão refrescante para os dias quentes.' },
  { nome: 'Muro de pintura', desc: 'Um espaço onde a criatividade ganha cores e formas livremente.' },
  { nome: 'Fantasias', desc: 'Para mergulhar no faz de conta e se transformar no que a imaginação quiser.' },
  { nome: 'Quintal verde', desc: 'Espaço para correr, brincar e encontrar a natureza em plena cidade.' },
  { nome: 'Sala de jogos', desc: 'Pingue-pongue, totó, air game, sinuca e jogos de tabuleiro.' },
  { nome: 'Casa no alto', desc: 'Uma cabana especial onde tudo é possível no mundo da imaginação.' },
  { nome: 'Espaço Baby', desc: 'Tapete e brincadeiras mais tranquilas para os pequenos.' },
  { nome: 'Futebol', desc: 'Espaço para correr, jogar e se divertir em grupo.' },
  { nome: 'Carrinhos e bonecos', desc: 'Brinquedos simples para reunir, criar histórias e resgatar o brincar de antigamente.' },
];
---
<Base title="O espaço da Casa Beliê — quintal verde e luz natural" description="Conheça os ambientes da casa: quintal, tanque de areia, muro de pintura, área molhada, vila, espaço baby e salões de luz natural." overHero>
  <HeroInterno kicker="Espaço & galeria" headline="Uma casa inteira para explorar." strokeWord="explorar" sub="Cerca de 800 m² em dois andares, com ambientes climatizados e um quintal verde cheio de possibilidades." surface="var(--areia)" starColor="#D98E6A" image="/images/hero-espaco-hq-2400.webp" imageMedium="/images/hero-espaco-hq-1600.webp" imageSmall="/images/hero-espaco-hq-mobile-768.webp" imageAvif="/images/hero-espaco-hq-2400.avif" imageMediumAvif="/images/hero-espaco-hq-1600.avif" imageSmallAvif="/images/hero-espaco-hq-mobile-768.avif" imageAlt="Área de convivência coberta da Casa Beliê com mesas, plantas e luz natural" imagePosition="53% 50%" imageWidth={2400} imageHeight={1350} />

  <section>
    <div class="shell">
      <span class="kicker k-verde reveal"><Star color="#3D5A34" /> Os ambientes</span>
      <h2 class="reveal">Quatorze convites para brincar.</h2>
      <p class="lead reveal">Cada ambiente foi pensado para estimular movimento, autonomia, imaginação e convivência entre crianças de diferentes idades.</p>
      <ul class="ambs reveal" role="list">
        {ambientes.map((ambiente, i) => (
          <li style={`transition-delay:${i * 0.035}s`}>
            <Star color="#6A5497" size={14} />
            <span><strong>{ambiente.nome}</strong><small>{ambiente.desc}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="galeria">
    <div class="shell">
      <span class="kicker reveal" style="color:var(--manteiga)"><Star color="#F7E8C9" /> Galeria</span>
      <h2 class="reveal">O muro de memórias da casa.</h2>
      <p class="lead reveal">Um passeio pela fachada, pelo quintal e pelos ambientes da Casa Beliê. Para acompanhar novos registros, visite o nosso <a href="https://www.instagram.com/casabelie/" target="_blank" rel="noopener">Instagram</a>.</p>
      <div class="mural reveal">
        {fotos.map((f, i) => (
          <button class={`tile ${f.slot}`} type="button" data-gallery-index={i} data-full={withBase(`/images/${f.src}-1600.webp`)} data-alt={f.alt} data-caption={f.cap} aria-label={`Abrir foto: ${f.cap}`} style={`transition-delay:${i * 0.06}s`}>
            <picture>
              <source type="image/avif" srcset={`${withBase(`/images/${f.src}-450.avif`)} 450w, ${withBase(`/images/${f.src}-800.avif`)} ${f.smlW}w, ${withBase(`/images/${f.src}-1600.avif`)} ${f.bigW}w`} sizes="(max-width:640px) 46vw, 22vw" />
              <img src={withBase(`/images/${f.src}-450.webp`)} srcset={`${withBase(`/images/${f.src}-450.webp`)} 450w, ${withBase(`/images/${f.src}-800.webp`)} ${f.smlW}w, ${withBase(`/images/${f.src}-1600.webp`)} ${f.bigW}w`} sizes="(max-width:640px) 46vw, 22vw" width={f.width} height={f.height} alt={f.alt} loading="lazy" decoding="async" />
            </picture>
            <span class="véu" aria-hidden="true"></span>
            <span class="cap"><Star color="#F7E8C9" size={14} /> {f.cap}</span>
          </button>
        ))}
        <a class="tile ig" href="https://www.instagram.com/casabelie/" target="_blank" rel="noopener" aria-label="Ver mais fotos no Instagram da Casa Beliê" data-evt="instagram">
          <span class="ig-mais">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
            <span>mais fotos<br/>no @casabelie</span>
          </span>
        </a>
      </div>
    </div>

    <dialog class="lightbox" id="galeria-lightbox" aria-label="Galeria de fotos da Casa Beliê">
      <div class="lightbox-panel">
        <div class="lightbox-media">
          <img class="lightbox-img" alt="" />
          <button class="lightbox-close" type="button" aria-label="Fechar galeria">×</button>
          <button class="lightbox-nav lightbox-prev" type="button" aria-label="Foto anterior">←</button>
          <button class="lightbox-nav lightbox-next" type="button" aria-label="Próxima foto">→</button>
        </div>
        <div class="lightbox-info">
          <p class="lightbox-caption"></p>
          <span class="lightbox-counter" aria-live="polite"></span>
        </div>
      </div>
    </dialog>
  </section>

  <section>
    <div class="shell mapa">
      <div class="reveal">
        <span class="kicker k-lav"><Star /> Onde fica</span>
        <h2>No coração de Laranjeiras.</h2>
        <p class="lead">Rua General Glicério, 131 — Laranjeiras, Rio de Janeiro/RJ. Rua bucólica, de fácil acesso pela Zona Sul.</p>
        <p class="acao"><a class="btn ghost dark" href="https://www.google.com/maps/search/?api=1&query=Casa%20Beli%C3%AA%20Rua%20General%20Glic%C3%A9rio%20131%20Laranjeiras%20Rio%20de%20Janeiro" target="_blank" rel="noopener" data-evt="mapa">Abrir no Google Maps</a></p>
      </div>
      <div class="mapa-frame reveal" style="transition-delay:.12s">
        <iframe title="Mapa — Casa Beliê, Rua General Glicério 131, Laranjeiras" src="https://www.google.com/maps?q=Rua%20General%20Glic%C3%A9rio%20131%20Laranjeiras%20Rio%20de%20Janeiro&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <CtaFinal headline="Quer ver tudo isso pessoalmente?" sub="Agende uma visita — o café fica por nossa conta." nota="tem estacionamento na região" />
</Base>

<style>
  .ambs{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:32px;padding:0;list-style:none}
  @media(max-width:900px){.ambs{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.ambs{grid-template-columns:1fr}}
  .ambs li{background:var(--brisa);border-radius:16px;padding:19px;display:flex;align-items:flex-start;gap:11px}
  .ambs strong{display:block;font-family:"Fraunces",serif;font-weight:450;font-size:1.05rem;line-height:1.3;margin-bottom:4px}
  .ambs small{display:block;color:var(--ink-suave);font-size:.82rem;line-height:1.45}
  .galeria{background:var(--mata);color:var(--papel)}
  .galeria h2{color:var(--papel)}
  .galeria .lead{color:rgba(253,250,244,.78)}
  .galeria .lead a{color:var(--manteiga);font-weight:800;text-decoration:none;border-bottom:1.5px solid rgba(247,232,201,.5)}
  .galeria .lead a:hover{border-bottom-color:var(--manteiga)}
  /* Mosaico bento — somente as fotos abrem o lightbox; o cartão final leva ao Instagram. */
  .mural{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    grid-template-rows:repeat(2, clamp(140px,17vw,210px)) clamp(170px,21vw,260px);
    grid-template-areas:"f1 f1 f2 f3" "f1 f1 f2 ig" "f4 f4 f5 f5";
    gap:clamp(10px,1.6vw,18px);
    margin-top:44px;
  }
  .tile{position:relative;display:block;border:0;padding:0;border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;font:inherit;text-align:left;cursor:zoom-in;
    box-shadow:0 10px 26px -16px rgba(0,0,0,.45)}
  .tile picture{display:block;width:100%;height:100%}
  .tile img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s var(--ease)}
  .tile:hover img{transform:scale(1.06)}
  .f1{grid-area:f1} .f2{grid-area:f2} .f3{grid-area:f3} .f4{grid-area:f4} .f5{grid-area:f5}
  .f1 img{object-position:50% 68%}
  .f3 img{object-position:50% 62%}
  .f5 img{object-position:50% 72%}
  .véu{position:absolute;inset:0;background:linear-gradient(to top, rgba(30,26,20,.72) 0%, rgba(30,26,20,.12) 45%, rgba(30,26,20,0) 70%);
    opacity:0;transition:opacity .35s var(--ease)}
  .tile:hover .véu,.tile:focus-visible .véu{opacity:1}
  .cap{position:absolute;left:14px;right:14px;bottom:12px;color:#fff;font-size:.85rem;font-weight:700;
    display:flex;align-items:center;gap:6px;opacity:0;transform:translateY(6px);transition:opacity .35s var(--ease),transform .35s var(--ease)}
  .tile:hover .cap,.tile:focus-visible .cap{opacity:1;transform:translateY(0)}
  .ig{grid-area:ig;background:var(--manteiga);display:flex;align-items:center;justify-content:center;text-align:center;box-shadow:none;cursor:pointer;transition:transform .35s var(--ease),background .35s}
  .ig:hover,.ig:focus-visible{transform:translateY(-3px);background:#f9e2b7}
  .ig-mais{display:flex;flex-direction:column;align-items:center;gap:6px;color:var(--mata);font-weight:800;font-size:.8rem;line-height:1.3}
  @media(max-width:640px){
    .mural{grid-template-columns:1fr 1fr;
      grid-template-rows:clamp(220px,62vw,300px) clamp(145px,38vw,200px) clamp(150px,42vw,220px) clamp(150px,42vw,220px);
      grid-template-areas:"f1 f2" "f3 ig" "f4 f4" "f5 f5"}
    .cap,.véu{opacity:1;transform:none}
    .véu{background:linear-gradient(to top, rgba(30,26,20,.62) 0%, rgba(30,26,20,0) 60%)}
  }
  .lightbox{width:min(94vw,1200px);height:min(92vh,900px);max-width:none;max-height:none;margin:auto;padding:0;border:0;background:transparent;color:#fff;overflow:visible}
  .lightbox::backdrop{background:rgba(19,18,20,.9);backdrop-filter:blur(8px)}
  .lightbox-panel{height:100%;display:grid;grid-template-rows:minmax(0,1fr) auto;gap:14px}
  .lightbox-media{position:relative;min-height:0;display:grid;place-items:center}
  .lightbox-img{display:block;width:auto;height:auto;max-width:100%;max-height:calc(92vh - 76px);border-radius:18px;box-shadow:0 28px 70px rgba(0,0,0,.5)}
  .lightbox-close,.lightbox-nav{position:absolute;border:1px solid rgba(255,255,255,.32);background:rgba(24,22,25,.62);color:#fff;display:grid;place-items:center;cursor:pointer;backdrop-filter:blur(8px);transition:background .25s,transform .25s var(--ease)}
  .lightbox-close:hover,.lightbox-nav:hover{background:var(--lav-prof);transform:scale(1.05)}
  .lightbox-close{top:12px;right:12px;width:44px;height:44px;border-radius:50%;font-size:1.8rem;line-height:1}
  .lightbox-nav{top:50%;width:48px;height:48px;border-radius:50%;font-size:1.25rem}
  .lightbox-prev{left:12px}.lightbox-next{right:12px}
  .lightbox-info{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:0 4px;font-size:.92rem}
  .lightbox-caption{font-family:Caveat,cursive;font-size:1.35rem}
  .lightbox-counter{color:rgba(255,255,255,.72);font-weight:800}
  @media(max-width:640px){
    .lightbox{width:94vw;height:88vh}
    .lightbox-img{max-height:calc(88vh - 72px)}
    .lightbox-nav{top:auto;bottom:12px;width:44px;height:44px}
    .lightbox-info{gap:12px;font-size:.82rem}
    .lightbox-caption{font-size:1.15rem;line-height:1.2}
  }
  .mapa{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(32px,5vw,72px);align-items:center}
  @media(max-width:880px){.mapa{grid-template-columns:1fr}}
  .mapa .acao{margin-top:22px}
  .mapa-frame{border-radius:20px;overflow:hidden;box-shadow:0 18px 40px -18px rgba(58,52,64,.3)}
  .mapa-frame iframe{width:100%;height:380px;border:0;display:block}
</style>

<script>
  const lightbox = document.querySelector('#galeria-lightbox');
  const galleryItems = [...document.querySelectorAll('[data-gallery-index]')];

  if (lightbox instanceof HTMLDialogElement && galleryItems.length) {
    const image = lightbox.querySelector('.lightbox-img');
    const caption = lightbox.querySelector('.lightbox-caption');
    const counter = lightbox.querySelector('.lightbox-counter');
    const close = lightbox.querySelector('.lightbox-close');
    const previous = lightbox.querySelector('.lightbox-prev');
    const next = lightbox.querySelector('.lightbox-next');
    let current = 0;

    const render = (index) => {
      current = (index + galleryItems.length) % galleryItems.length;
      const item = galleryItems[current];
      if (image instanceof HTMLImageElement) {
        image.src = item.dataset.full ?? '';
        image.alt = item.dataset.alt ?? '';
      }
      if (caption) caption.textContent = item.dataset.caption ?? '';
      if (counter) counter.textContent = `${current + 1} / ${galleryItems.length}`;
    };

    galleryItems.forEach((item, index) => item.addEventListener('click', () => {
      render(index);
      lightbox.showModal();
    }));
    close?.addEventListener('click', () => lightbox.close());
    previous?.addEventListener('click', () => render(current - 1));
    next?.addEventListener('click', () => render(current + 1));
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') render(current - 1);
      if (event.key === 'ArrowRight') render(current + 1);
    });
  }
</script>
